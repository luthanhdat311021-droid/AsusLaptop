@{
    ViewData["Title"] = "Phương thức thanh toán";
}

<div class="support-page">
    <div class="support-hero">
        <i class="fa fa-credit-card support-hero-icon" style="color:var(--zen-blue)"></i>
        <h1>Phương Thức Thanh Toán</h1>
        <p>Đa dạng hình thức thanh toán, an toàn và tiện lợi</p>
    </div>

    <div class="support-container">
        <div class="support-card">
            <h3><i class="fa fa-money-bill-wave" style="color:var(--success)"></i> Thanh toán khi nhận hàng (COD)</h3>
            <div class="payment-method-card">
                <div class="payment-icon"><i class="fa fa-truck fa-2x" style="color:var(--success)"></i></div>
                <div class="payment-detail">
                    <p>Nhận hàng, kiểm tra sản phẩm rồi mới thanh toán. Áp dụng toàn quốc.</p>
                    <ul class="support-list" style="margin-top:10px">
                        <li><i class="fa fa-check" style="color:var(--success)"></i> Không cần thẻ ngân hàng</li>
                        <li><i class="fa fa-check" style="color:var(--success)"></i> Kiểm tra hàng trước khi nhận</li>
                        <li><i class="fa fa-info-circle" style="color:var(--tuf-yellow)"></i> Áp dụng cho đơn dưới 30 triệu đồng</li>
                    </ul>
                </div>
            </div>
        </div>

        <div class="support-card">
            <h3><i class="fa fa-university" style="color:var(--accent)"></i> Chuyển khoản ngân hàng</h3>
            <div class="payment-method-card">
                <div class="payment-icon"><i class="fa fa-qrcode fa-2x" style="color:var(--accent)"></i></div>
                <div class="payment-detail">
                    <p>Quét mã QR hoặc chuyển khoản thủ công. Đơn hàng xử lý sau khi xác nhận thanh toán.</p>
                    <div class="bank-info" style="margin-top:12px;background:var(--bg-card2);border-radius:var(--radius);padding:14px;font-size:13px;line-height:2">
                        <div><span style="color:var(--text-muted);display:inline-block;width:130px">Ngân hàng:</span> <strong>Vietcombank (VCB)</strong></div>
                        <div><span style="color:var(--text-muted);display:inline-block;width:130px">Số tài khoản:</span> <strong style="color:var(--accent)">1234567890</strong></div>
                        <div><span style="color:var(--text-muted);display:inline-block;width:130px">Chủ tài khoản:</span> <strong>ASUS LAPTOP STORE</strong></div>
                        <div><span style="color:var(--text-muted);display:inline-block;width:130px">Nội dung CK:</span> <strong style="color:var(--tuf-yellow)">Tên + SĐT + Mã đơn hàng</strong></div>
                    </div>
                </div>
            </div>
        </div>

        <div class="support-card">
            <h3><i class="fa fa-mobile-alt" style="color:var(--accent2)"></i> Ví điện tử & thẻ quốc tế</h3>
            <div class="ewallet-list">
                <div class="ewallet-item"><i class="fa fa-wallet"></i> MoMo <span style="background:var(--success);color:#fff;font-size:9px;font-weight:700;padding:2px 6px;border-radius:4px;margin-left:4px">THANH TOÁN TRỰC TIẾP</span></div>
                <div class="ewallet-item"><i class="fa fa-wallet"></i> ZaloPay</div>
                <div class="ewallet-item"><i class="fa fa-credit-card"></i> Visa / Mastercard (qua VNPay)</div>
                <div class="ewallet-item"><i class="fa fa-credit-card"></i> JCB (qua VNPay)</div>
            </div>
            <p style="color:var(--text-muted);font-size:13px;margin-top:12px">
                <i class="fa fa-info-circle"></i> Chọn "Ví MoMo" ngay tại bước thanh toán để quét mã QR. Nếu tài khoản MoMo của bạn đã bật <strong>Ví trả sau</strong>, bạn có thể chọn nguồn tiền này ngay trong app MoMo — hạn mức và điều kiện do MoMo xét duyệt.
            </p>
        </div>

        <div class="support-card">
            <h3><i class="fa fa-file-invoice-dollar" style="color:var(--proart-orange)"></i> Trả góp 0%</h3>
            <div class="payment-method-card">
                <div class="payment-icon"><i class="fa fa-percentage fa-2x" style="color:var(--proart-orange)"></i></div>
                <div class="payment-detail">
                    <ul class="support-list">
                        <li><i class="fa fa-check" style="color:var(--success)"></i> Trả góp 0% qua thẻ tín dụng các ngân hàng lớn</li>
                        <li><i class="fa fa-check" style="color:var(--success)"></i> Kỳ hạn 3, 6, 12, 24 tháng</li>
                        <li><i class="fa fa-check" style="color:var(--success)"></i> Áp dụng cho đơn từ 3 triệu đồng</li>
                        <li><i class="fa fa-info-circle" style="color:var(--tuf-yellow)"></i> Liên hệ hotline để biết thêm chi tiết</li>
                    </ul>
                </div>
            </div>
        </div>
    </div>
</div>

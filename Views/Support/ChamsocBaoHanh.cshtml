<!-- Modal Đặt Lịch Bảo Dưỡng -->
<div class="modal fade modal-glass" id="bookingModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-lg">
        <div class="modal-content">
            <form method="post" action="/Support/CreateMaintenanceBooking">
                @Html.AntiForgeryToken()
                <div class="modal-header">
                    <h5 class="modal-title fw-bold text-white display-7">
                        <i class="fa-solid fa-screwdriver-wrench me-2" style="color:#ff4d00"></i>
                        Đặt Lịch Đặt Vệ Sinh / Bảo Dưỡng Máy
                    </h5>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>

                <div class="modal-body">
                    <div class="row g-3">
                        <div class="col-md-6">
                            <label>Số Serial Thiết Bị <span class="text-danger">*</span></label>
                            <input type="text" id="modalSerialNo" name="serialNo" class="form-control" readonly style="font-family:monospace; font-weight:700; color:#ff7733;" required />
                        </div>
                        <div class="col-md-6">
                            <label>Tên Sản Phẩm <span class="text-danger">*</span></label>
                            <input type="text" id="modalProductName" name="productName" class="form-control" readonly required />
                        </div>

                        <div class="col-md-6">
                            <label>Loại Dịch Vụ <span class="text-danger">*</span></label>
                            <select name="serviceType" class="form-select" required>
                                <option value="Vệ sinh tản nhiệt định kỳ (Miễn phí)">Vệ sinh tản nhiệt định kỳ (Miễn phí)</option>
                                <option value="Thay keo tản nhiệt Liquid Metal / Graphene">Thay keo tản nhiệt Liquid Metal / Graphene</option>
                                <option value="Kiểm tra & Chẩn đoán tổng thể phần cứng">Kiểm tra & Chẩn đoán tổng thể phần cứng</option>
                                <option value="Hỗ trợ nâng cấp RAM / SSD chính hãng">Hỗ trợ nâng cấp RAM / SSD chính hãng</option>
                                <option value="Hỗ trợ Cài đặt phần mềm / Driver / BIOS">Hỗ trợ Cài đặt phần mềm / Driver / BIOS</option>
                            </select>
                        </div>

                        <div class="col-md-6">
                            <label>Hình Thức Phục Vụ <span class="text-danger">*</span></label>
                            <select name="serviceMethod" class="form-select" required>
                                <option value="Mang tới Showroom">Mang trực tiếp tới Showroom ASUS</option>
                                <option value="Gửi nhận tận nhà miễn phí">Gửi nhận tận nhà miễn phí (Ahamove/GHTK)</option>
                            </select>
                        </div>

                        <div class="col-md-6">
                            <label>Ngày Hẹn Bảo Dưỡng <span class="text-danger">*</span></label>
                            <input type="date" name="preferredDate" class="form-control" value="@DateTime.Today.AddDays(1).ToString("yyyy-MM-dd")" min="@DateTime.Today.ToString("yyyy-MM-dd")" required />
                        </div>

                        <div class="col-md-6">
                            <label>Khung Giờ Mong Muốn <span class="text-danger">*</span></label>
                            <select name="preferredTime" class="form-select" required>
                                <option value="09:00 - 11:30">Buổi sáng (09:00 - 11:30)</option>
                                <option value="13:30 - 17:00">Buổi chiều (13:30 - 17:00)</option>
                                <option value="17:30 - 20:00">Buổi tối (17:30 - 20:00)</option>
                            </select>
                        </div>

                        <div class="col-md-6">
                            <label>Họ và Tên Khách Hàng <span class="text-danger">*</span></label>
                            <input type="text" name="customerName" class="form-control" value="@Model.CustomerName" placeholder="Nhập họ tên..." required />
                        </div>

                        <div class="col-md-6">
                            <label>Số Điện Thoại Liên Hệ <span class="text-danger">*</span></label>
                            <input type="tel" name="phone" class="form-control" value="@Model.CustomerPhone" placeholder="Nhập số điện thoại..." required />
                        </div>

                        <div class="col-12">
                            <label>Địa Chỉ Khách Hàng (Dành cho dịch vụ gửi nhận tận nhà)</label>
                            <input type="text" name="address" class="form-control" placeholder="Số nhà, tên đường, Phường/Xã, Quận/Huyện..." />
                        </div>

                        <div class="col-12">
                            <label>Ghi Chú Thêm (Nếu có)</label>
                            <textarea name="note" class="form-control" rows="2" placeholder="Ví dụ: Máy chạy quạt hơi kêu to, muốn vệ sinh sạch bụi và tra keo mới..."></textarea>
                        </div>
                    </div>
                </div>

                <div class="modal-footer">
                    <button type="button" class="btn btn-outline-light" data-bs-dismiss="modal">Hủy Bỏ</button>
                    <button type="submit" class="btn btn-primary px-4" style="background: #ff4d00; border: none; border-radius: 8px; font-weight: 700;">
                        <i class="fa-solid fa-paper-plane me-2"></i> Xác Nhận Đặt Lịch
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

<script>
    function openBookingModalFromBtn(btn) {
        var serialNo = btn.getAttribute('data-serial') || '';
        var productName = btn.getAttribute('data-product') || '';
        openBookingModal(serialNo, productName);
    }

    function openBookingModal(serialNo, productName) {
        document.getElementById('modalSerialNo').value = serialNo;
        document.getElementById('modalProductName').value = productName;
        
        var modalElem = document.getElementById('bookingModal');
        var modal = new bootstrap.Modal(modalElem);
        modal.show();
    }
</script>

@{
    ViewData["Title"] = "Hỗ trợ kỹ thuật trực tuyến";
}

<div class="support-page">
    <div class="support-hero">
        <i class="fa fa-headset support-hero-icon" style="color:var(--accent)"></i>
        <h1>Hỗ Trợ Kỹ Thuật Trực Tuyến</h1>
        <p>Đội ngũ kỹ thuật viên sẵn sàng hỗ trợ bạn 24/7</p>
    </div>

    <div class="support-container">

        <!-- Chat trực tuyến -->
        <div class="support-card">
            <h3><i class="fa fa-comment-dots" style="color:var(--accent)"></i> Chat với kỹ thuật viên</h3>
            <div class="chat-box">
                <div class="chat-messages" id="chatMessages">
                    <div class="chat-msg bot">
                        <div class="chat-avatar"><i class="fa fa-robot"></i></div>
                        <div class="chat-bubble">Xin chào! Tôi là hỗ trợ viên ASUS. Bạn đang gặp vấn đề gì với sản phẩm? 😊</div>
                    </div>
                </div>
                <div class="chat-input-row">
                    <input type="text" id="chatInput" class="form-control" placeholder="Nhập câu hỏi của bạn..." onkeydown="if(event.key==='Enter') sendChat()" />
                    <button class="btn-primary" onclick="sendChat()"><i class="fa fa-paper-plane"></i></button>
                </div>
            </div>
        </div>

        <!-- Liên hệ trực tiếp -->
        <div class="support-card">
            <h3><i class="fa fa-phone-alt" style="color:var(--success)"></i> Liên hệ trực tiếp</h3>
            <div class="contact-grid">
                <div class="contact-item">
                    <div class="contact-icon" style="background:rgba(0,196,140,0.1);border-color:rgba(0,196,140,0.3)">
                        <i class="fa fa-phone" style="color:var(--success)"></i>
                    </div>
                    <div class="contact-detail">
                        <strong>Hotline kỹ thuật</strong>
                        <span style="color:var(--success);font-size:18px;font-weight:700">1800 1234</span>
                        <span style="color:var(--text-muted);font-size:12px">Miễn phí • 8:00 - 21:00 mỗi ngày</span>
                    </div>
                </div>
                <div class="contact-item">
                    <div class="contact-icon" style="background:rgba(0,180,216,0.1);border-color:rgba(0,180,216,0.3)">
                        <i class="fa fa-envelope" style="color:var(--accent)"></i>
                    </div>
                    <div class="contact-detail">
                        <strong>Email hỗ trợ</strong>
                        <span style="color:var(--accent)">support@asuslaptop.vn</span>
                        <span style="color:var(--text-muted);font-size:12px">Phản hồi trong vòng 2 giờ</span>
                    </div>
                </div>
                <div class="contact-item">
                    <div class="contact-icon" style="background:rgba(123,47,255,0.1);border-color:rgba(123,47,255,0.3)">
                        <i class="fab fa-facebook-messenger" style="color:var(--accent2)"></i>
                    </div>
                    <div class="contact-detail">
                        <strong>Facebook Messenger</strong>
                        <span style="color:var(--accent2)">fb.com/ASUSLaptopStore</span>
                        <span style="color:var(--text-muted);font-size:12px">Phản hồi trong vài phút</span>
                    </div>
                </div>
                <div class="contact-item">
                    <div class="contact-icon" style="background:rgba(245,196,0,0.1);border-color:rgba(245,196,0,0.3)">
                        <i class="fab fa-zalo" style="color:var(--tuf-yellow)"></i>
                    </div>
                    <div class="contact-detail">
                        <strong>Zalo OA</strong>
                        <span style="color:var(--tuf-yellow)">ASUS Laptop Store</span>
                        <span style="color:var(--text-muted);font-size:12px">Phản hồi trong vài phút</span>
                    </div>
                </div>
            </div>
        </div>

        <!-- Gửi yêu cầu hỗ trợ -->
        <div class="support-card">
            <h3><i class="fa fa-tools" style="color:var(--tuf-yellow)"></i> Gửi yêu cầu hỗ trợ kỹ thuật</h3>
            <div class="support-form" id="ticketForm">
                <div class="form-row">
                    <div class="form-group">
                        <label>Họ và tên</label>
                        <input type="text" class="form-control" id="tkName" placeholder="Nguyễn Văn A" />
                    </div>
                    <div class="form-group">
                        <label>Số điện thoại</label>
                        <input type="text" class="form-control" id="tkPhone" placeholder="0901 234 567" />
                    </div>
                </div>
                <div class="form-group">
                    <label>Tên / Model sản phẩm</label>
                    <input type="text" class="form-control" id="tkProduct" placeholder="Ví dụ: ASUS ROG Strix G733ZW" />
                </div>
                <div class="form-group">
                    <label>Loại vấn đề</label>
                    <select class="form-control" id="tkType">
                        <option value="">-- Chọn loại vấn đề --</option>
                        <option>Màn hình / Hiển thị</option>
                        <option>Bàn phím / Chuột</option>
                        <option>Pin / Sạc</option>
                        <option>Quạt tản nhiệt / Nóng máy</option>
                        <option>Âm thanh / Loa</option>
                        <option>Kết nối WiFi / Bluetooth</option>
                        <option>Hệ điều hành / Driver</option>
                        <option>Hiệu năng chậm</option>
                        <option>Khác</option>
                    </select>
                </div>
                <div class="form-group">
                    <label>Mô tả chi tiết vấn đề</label>
                    <textarea class="form-control" id="tkDesc" rows="4" placeholder="Mô tả chi tiết lỗi bạn đang gặp phải..."></textarea>
                </div>
                <button class="btn-primary" onclick="submitTicket()">
                    <i class="fa fa-paper-plane"></i> Gửi yêu cầu hỗ trợ
                </button>
            </div>
            <div id="ticketSuccess" style="display:none;text-align:center;padding:32px 0">
                <i class="fa fa-check-circle" style="font-size:48px;color:var(--success);display:block;margin-bottom:16px"></i>
                <h4 style="margin-bottom:8px">Yêu cầu đã được gửi!</h4>
                <p style="color:var(--text-secondary)">Kỹ thuật viên sẽ liên hệ với bạn trong vòng <strong style="color:var(--accent)">30 phút</strong>.</p>
            </div>
        </div>

        <!-- Câu hỏi kỹ thuật phổ biến -->
        <div class="support-card">
            <h3><i class="fa fa-lightbulb" style="color:var(--proart-orange)"></i> Tự xử lý nhanh</h3>
            <div class="faq-list">
                <div class="faq-item">
                    <div class="faq-question" onclick="toggleFaq(this)">
                        <span>Laptop bị nóng, quạt chạy to bất thường</span>
                        <i class="fa fa-chevron-down"></i>
                    </div>
                    <div class="faq-answer">
                        1. Vệ sinh khe tản nhiệt bằng khí nén. 2. Đặt laptop trên bề mặt cứng, thoáng. 3. Kiểm tra Task Manager xem ứng dụng nào đang chiếm CPU/GPU cao. 4. Cập nhật driver và BIOS lên phiên bản mới nhất. 5. Nếu vẫn còn, liên hệ kỹ thuật viên để vệ sinh máy chuyên sâu.
                    </div>
                </div>
                <div class="faq-item">
                    <div class="faq-question" onclick="toggleFaq(this)">
                        <span>Laptop không nhận sạc hoặc pin không tăng</span>
                        <i class="fa fa-chevron-down"></i>
                    </div>
                    <div class="faq-answer">
                        1. Thử cắm rút adapter vài lần. 2. Kiểm tra đầu cắm không bị bụi bẩn. 3. Vào Device Manager → Batteries → Uninstall "Microsoft ACPI-Compliant Control Method Battery", rồi restart. 4. Kiểm tra adapter bằng thiết bị khác nếu có. 5. Nếu vẫn lỗi, pin hoặc adapter cần được thay thế.
                    </div>
                </div>
                <div class="faq-item">
                    <div class="faq-question" onclick="toggleFaq(this)">
                        <span>Màn hình bị sọc, nhấp nháy hoặc đốm đen</span>
                        <i class="fa fa-chevron-down"></i>
                    </div>
                    <div class="faq-answer">
                        1. Cập nhật driver GPU (NVIDIA/AMD/Intel). 2. Thử kết nối màn hình ngoài để xác định lỗi panel hay GPU. 3. Tắt tính năng "Variable Refresh Rate" trong Settings → Display. 4. Nếu màn hình ngoài hiển thị tốt → lỗi panel, cần bảo hành. 5. Liên hệ trung tâm để kiểm tra miễn phí.
                    </div>
                </div>
                <div class="faq-item">
                    <div class="faq-question" onclick="toggleFaq(this)">
                        <span>WiFi bị ngắt kết nối liên tục</span>
                        <i class="fa fa-chevron-down"></i>
                    </div>
                    <div class="faq-answer">
                        1. Cập nhật driver WiFi mới nhất từ trang ASUS. 2. Vào Device Manager → Network Adapters → WiFi card → Properties → Power Management → bỏ tick "Allow the computer to turn off this device". 3. Đổi băng tần từ 2.4GHz sang 5GHz hoặc ngược lại. 4. Reset TCP/IP: chạy CMD với quyền Admin, gõ "netsh int ip reset".
                    </div>
                </div>
            </div>
        </div>

    </div>
</div>

<script>
// FAQ toggle
function toggleFaq(el) {
    var answer = el.nextElementSibling;
    var icon = el.querySelector('i');
    var isOpen = answer.style.maxHeight && answer.style.maxHeight !== '0px';
    answer.style.maxHeight = isOpen ? '0px' : answer.scrollHeight + 'px';
    answer.style.opacity = isOpen ? '0' : '1';
    icon.style.transform = isOpen ? 'rotate(0deg)' : 'rotate(180deg)';
}

// ===== CLAUDE AI CHAT =====
var chatHistory = [];

function escapeHtml(text) {
    return text.replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;');
}

function appendMessage(role, html) {
    var box = document.getElementById('chatMessages');
    if (role === 'user') {
        box.innerHTML += '<div class="chat-msg user"><div class="chat-bubble">' + html + '</div></div>';
    } else {
        box.innerHTML += '<div class="chat-msg bot"><div class="chat-avatar"><i class="fa fa-robot"></i></div><div class="chat-bubble">' + html + '</div></div>';
    }
    box.scrollTop = box.scrollHeight;
}

function setTyping(show) {
    var existing = document.getElementById('typingIndicator');
    if (existing) existing.remove();
    if (show) {
        var box = document.getElementById('chatMessages');
        box.innerHTML += '<div class="chat-msg bot" id="typingIndicator"><div class="chat-avatar"><i class="fa fa-robot"></i></div><div class="chat-bubble typing-dots"><span></span><span></span><span></span></div></div>';
        box.scrollTop = box.scrollHeight;
    }
}

async function sendChat() {
    var input = document.getElementById('chatInput');
    var msg = input.value.trim();
    if (!msg) return;

    var btn = document.querySelector('.chat-input-row .btn-primary');
    input.disabled = true;
    btn.disabled = true;

    appendMessage('user', escapeHtml(msg));
    chatHistory.push({ role: 'user', content: msg });
    input.value = '';
    setTyping(true);

    try {
        var response = await fetch('/api/Chat/send', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ messages: chatHistory })
        });

        var data = await response.json();
        setTyping(false);

        var reply = data.reply || 'Xin lỗi, có lỗi xảy ra. Vui lòng gọi hotline 1800 1234 để được hỗ trợ.';
        chatHistory.push({ role: 'assistant', content: reply });
        appendMessage('bot', escapeHtml(reply));

    } catch (err) {
        setTyping(false);
        appendMessage('bot', 'Xin lỗi, không thể kết nối lúc này. Vui lòng gọi hotline <strong>1800 1234</strong> để được hỗ trợ trực tiếp.');
    }

    input.disabled = false;
    btn.disabled = false;
    input.focus();
}

// Submit ticket
function submitTicket() {
    var name = document.getElementById('tkName').value.trim();
    var phone = document.getElementById('tkPhone').value.trim();
    var type = document.getElementById('tkType').value;
    var desc = document.getElementById('tkDesc').value.trim();
    if (!name || !phone || !type || !desc) { alert('Vui lòng điền đầy đủ thông tin!'); return; }
    document.getElementById('ticketForm').style.display = 'none';
    document.getElementById('ticketSuccess').style.display = 'block';
}
</script>

@{
    ViewData["Title"] = "Hướng dẫn mua hàng";
}

<div class="support-page">
    <div class="support-hero">
        <i class="fa fa-shopping-cart support-hero-icon" style="color:var(--tuf-yellow)"></i>
        <h1>Hướng Dẫn Mua Hàng</h1>
        <p>Quy trình đặt hàng đơn giản, nhanh chóng và an toàn tại ASUS Laptop Store</p>
    </div>

    <div class="support-container">
        <div class="support-card">
            <h3><i class="fa fa-list-ol" style="color:var(--accent)"></i> Các bước đặt hàng online</h3>
            <div class="steps-list">
                <div class="step-item">
                    <div class="step-num">1</div>
                    <div class="step-content">
                        <strong>Chọn sản phẩm</strong>
                        <p>Duyệt danh mục, lọc theo dòng sản phẩm, giá hoặc tìm kiếm theo tên. Nhấn vào sản phẩm để xem chi tiết cấu hình.</p>
                    </div>
                </div>
                <div class="step-item">
                    <div class="step-num">2</div>
                    <div class="step-content">
                        <strong>Thêm vào giỏ hàng</strong>
                        <p>Nhấn <strong>"Thêm vào giỏ"</strong> trên trang chi tiết sản phẩm. Có thể tiếp tục mua sắm hoặc vào giỏ hàng để thanh toán.</p>
                    </div>
                </div>
                <div class="step-item">
                    <div class="step-num">3</div>
                    <div class="step-content">
                        <strong>Điền thông tin giao hàng</strong>
                        <p>Nhập họ tên, số điện thoại và địa chỉ nhận hàng. Đăng nhập tài khoản để tự động điền thông tin.</p>
                    </div>
                </div>
                <div class="step-item">
                    <div class="step-num">4</div>
                    <div class="step-content">
                        <strong>Chọn phương thức thanh toán</strong>
                        <p>COD (thanh toán khi nhận hàng) hoặc chuyển khoản ngân hàng qua mã QR.</p>
                    </div>
                </div>
                <div class="step-item">
                    <div class="step-num">5</div>
                    <div class="step-content">
                        <strong>Xác nhận đơn hàng</strong>
                        <p>Nhân viên sẽ gọi xác nhận trong vòng 30 phút. Đơn hàng sẽ được đóng gói và giao trong 2-5 ngày làm việc.</p>
                    </div>
                </div>
            </div>
        </div>

        <div class="support-card">
            <h3><i class="fa fa-truck" style="color:var(--success)"></i> Thông tin vận chuyển</h3>
            <div class="info-table">
                <div class="info-row">
                    <span class="info-label">Khu vực nội thành HCM/HN</span>
                    <span class="info-value" style="color:var(--success)">Miễn phí • 1-2 ngày</span>
                </div>
                <div class="info-row">
                    <span class="info-label">Tỉnh thành khác</span>
                    <span class="info-value">30.000đ • 3-5 ngày</span>
                </div>
                <div class="info-row">
                    <span class="info-label">Giao hàng nhanh</span>
                    <span class="info-value" style="color:var(--tuf-yellow)">Liên hệ hotline</span>
                </div>
            </div>
        </div>

        <div class="support-card">
            <h3><i class="fa fa-question-circle" style="color:var(--accent2)"></i> Cần hỗ trợ?</h3>
            <ul class="support-list">
                <li><i class="fa fa-phone" style="color:var(--tuf-yellow)"></i> Hotline: <strong>1800 1234</strong> (miễn phí, 8:00 - 21:00)</li>
                <li><i class="fa fa-envelope" style="color:var(--accent)"></i> Email: <strong>support@asuslaptop.vn</strong></li>
                <li><i class="fa fa-comment" style="color:var(--success)"></i> Chat trực tuyến trên website</li>
            </ul>
        </div>
    </div>
</div>

        .product-quickview {
            position: absolute;
            left: 0; right: 0; bottom: 0;
            padding: 10px;
            display: flex;
            justify-content: center;
            background: linear-gradient(to top, rgba(0,0,0,0.55), transparent);
            opacity: 0;

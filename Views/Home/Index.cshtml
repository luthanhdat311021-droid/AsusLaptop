@section Scripts {
    <script src="~/js/site.js"></script>
    <script src="~/js/site-automation.js"></script>
    <script>
        // Landing Page FAQ Accordion Toggle
        document.addEventListener('DOMContentLoaded', function() {
            document.querySelectorAll('.landing-faq-btn').forEach(function(btn) {
                btn.addEventListener('click', function() {
                    var card = this.closest('.landing-faq-card');
                    card.classList.toggle('open');
                });
            });
        });
    </script>
    <script>
        (function () {
            'use strict';

            // Scroll reveal animation
            const revealObs = new IntersectionObserver((entries) => {
                let delay = 0;
                entries.forEach(entry => {
                    if (entry.isIntersecting) {
                        setTimeout(() => entry.target.classList.add('visible'), delay);
                        delay += 60;
                        revealObs.unobserve(entry.target);
                    }
                });
            }, { threshold: 0.1, rootMargin: '0px 0px -30px 0px' });

            document.querySelectorAll('.reveal:not(.visible)').forEach(el => revealObs.observe(el));

            // Wishlist AJAX handler
            if (typeof window.addToWishlistAjax !== 'function') {
                window.addToWishlistAjax = function (id, btn) {
                    fetch('/Wishlist/Toggle?productId=' + id, { method: 'POST' })
                        .then(r => r.json())
                        .then(data => {
                            if (data.requireLogin) {
                                window.location.href = '/Account/Login';
                                return;
                            }
                            if (data.success) {
                                btn.style.color = data.added ? '#e0393e' : '#111111';
                            }
                        })
                        .catch(() => {});
                };
            }
        })();

        // ───── BANNER VIDEO: tự động phát video MP4 liên tục ─────
        (function () {
            function forcePlayVideos() {
                document.querySelectorAll('video').forEach(function (v) {
                    v.muted = true;
                    v.defaultMuted = true;
                    v.playsInline = true;
                    v.setAttribute('muted', '');
                    v.setAttribute('playsinline', '');
                    v.setAttribute('autoplay', '');
                    
                    var p = v.play();
                    if (p !== undefined) {
                        p.catch(function () {});
                    }
                });
            }

            forcePlayVideos();
            if (document.readyState === 'complete') {
                forcePlayVideos();
            } else {
                window.addEventListener('load', forcePlayVideos);
            }

            var events = ['click', 'touchstart', 'scroll', 'mousemove'];
            function onUserInteraction() {
                forcePlayVideos();
                events.forEach(function (e) {
                    document.removeEventListener(e, onUserInteraction);
                });
            }
            events.forEach(function (e) {
                document.addEventListener(e, onUserInteraction, { passive: true, once: true });
            });
        })();

        // ───── NIKE-STYLE HERO CAROUSEL (fade + progress bar) ─────
        (function () {
            var slider = document.getElementById('hero') || document.getElementById('mainHeroSlider') || document.querySelector('.nk-hero-carousel');
            if (!slider) return;

            var track = document.getElementById('heroTrack') || slider.querySelector('.hero-slider-track');
            if (!track) return;
            var slides = track.querySelectorAll('.hero-slide');
            var dotsBox = document.getElementById('heroDots');
            var prevBtn = document.getElementById('heroPrev');
            var nextBtn = document.getElementById('heroNext');
            var count = slides.length;
            var current = 0;
            var timer = null;
            var AUTO_MS = 6000;

            dotsBox.style.setProperty('--slide-duration', (AUTO_MS / 1000) + 's');

            for (var i = 0; i < count; i++) {
                var dot = document.createElement('button');
                dot.className = 'slider-dot' + (i === 0 ? ' active' : '');
                dot.type = 'button';
                dot.setAttribute('aria-label', 'Slide ' + (i + 1));
                dot.addEventListener('click', (function (idx) {
                    return function () { goTo(idx); restart(); };
                })(i));
                dotsBox.appendChild(dot);
            }
            var dots = dotsBox.querySelectorAll('.slider-dot');

            function updateProgressDots() {
                dots.forEach(function (d, i) {
                    d.classList.remove('active', 'done');
                    if (i < current) d.classList.add('done');
                    else if (i === current) {
                        d.classList.add('active');
                        void d.offsetWidth;
                    }
                });
            }

            function syncVideos() {
                slides.forEach(function (slide, idx) {
                    var vid = slide.querySelector('video');
                    if (!vid) return;
                    if (idx === current) {
                        vid.currentTime = 0;
                        var playPromise = vid.play();
                        if (playPromise !== undefined) {
                            playPromise.catch(function () {});
                        }
                    } else {
                        vid.pause();
                    }
                });
            }

            function goTo(idx) {
                current = (idx + count) % count;
                slides.forEach(function (s, i) { s.classList.toggle('active', i === current); });
                updateProgressDots();
                syncVideos();
            }

            function next() { goTo(current + 1); }
            function prev() { goTo(current - 1); }
            function restart() {
                clearInterval(timer);
                timer = setInterval(next, AUTO_MS);
            }

            if (nextBtn) nextBtn.addEventListener('click', function () { next(); restart(); });
            if (prevBtn) prevBtn.addEventListener('click', function () { prev(); restart(); });

            slider.addEventListener('mouseenter', function () { clearInterval(timer); });
            slider.addEventListener('mouseleave', restart);

            var touchStartX = 0;
            track.addEventListener('touchstart', function (e) { touchStartX = e.touches[0].clientX; }, { passive: true });
            track.addEventListener('touchend', function (e) {
                var dx = e.changedTouches[0].clientX - touchStartX;
                if (Math.abs(dx) > 40) { dx < 0 ? next() : prev(); restart(); }
            }, { passive: true });

            syncVideos();
            updateProgressDots();
            restart();
        })();

        // ───── LIVE DYNAMIC FLASH SALE COUNTDOWN TIMER (CỐ ĐỊNH 20:00 HẰNG NGÀY & LUÔN CHẠY) ─────
        (function () {
            function getNextSlotEndTime() {
                var now = new Date();
                var today8PM = new Date(now.getFullYear(), now.getMonth(), now.getDate(), 20, 0, 0).getTime();
                var today11PM = new Date(now.getFullYear(), now.getMonth(), now.getDate(), 23, 0, 0).getTime();
                var tom8PM = new Date(now.getFullYear(), now.getMonth(), now.getDate() + 1, 20, 0, 0).getTime();

                if (now.getTime() < today8PM) {
                    return today8PM; // Chưa tới 8h tối hôm nay -> Đếm ngược đến 20:00 hôm nay
                } else if (now.getTime() < today11PM) {
                    return today11PM; // Đang từ 8h - 11h tối -> Đếm ngược đến 23:00 kết thúc
                } else {
                    return tom8PM;   // Đã qua 11h tối -> Đếm ngược đến 20:00 ngày mai
                }
            }

            function syncFlashSaleUiState() {
                var now = new Date();
                var today8PM = new Date(now.getFullYear(), now.getMonth(), now.getDate(), 20, 0, 0).getTime();
                var today11PM = new Date(now.getFullYear(), now.getMonth(), now.getDate(), 23, 0, 0).getTime();
                var isActive = now.getTime() >= today8PM && now.getTime() < today11PM;

                document.querySelectorAll('.flash-sub-badge').forEach(function (el) {
                    el.textContent = 'KHUNG GIỜ 20:00 - 23:00 ' + (isActive ? '• ĐANG DIỄN RA' : '• SẮP DIỄN RA');
                });
                document.querySelectorAll('.flash-timer-label').forEach(function (el) {
                    el.textContent = isActive ? 'KẾT THÚC SAU:' : 'BẮT ĐẦU SAU:';
                });
                document.querySelectorAll('.flash-card').forEach(function (card) {
                    var btn = card.querySelector('.flash-buy-btn');
                    if (!btn) return;
                    if (isActive) {
                        if (btn.classList.contains('disabled')) {
                            btn.classList.remove('disabled');
                            btn.removeAttribute('disabled');
                            btn.removeAttribute('title');
                            btn.innerHTML = '<i class="fa fa-bolt"></i> Mua Ngay Flash Sale';
                            var cardLink = card.querySelector('a[href*="/Product/Details/"]');
                            if (cardLink) {
                                var pId = cardLink.getAttribute('href').split('/').pop();
                                btn.setAttribute('onclick', 'addToCartAjax(' + pId + ', this)');
                            }
                        }
                    } else {
                        btn.classList.add('disabled');
                        btn.setAttribute('disabled', 'disabled');
                        btn.setAttribute('title', 'Chưa đến khung giờ Flash Sale');
                        btn.innerHTML = '<i class="fa fa-clock"></i> Sắp Đến Giờ Sale';
                        btn.removeAttribute('onclick');
                    }
                });
            }

            var timerBox = document.getElementById('flashTimerBox') || document.getElementById('flashTickerBox');
            var endTimeStr = timerBox ? timerBox.getAttribute('data-endtime') : null;
            var endTime = null;

            if (endTimeStr) {
                var parts = endTimeStr.split(/[-T:]/);
                if (parts.length >= 6) {
                    endTime = new Date(parts[0], parts[1] - 1, parts[2], parts[3], parts[4], parts[5]).getTime();
                } else {
                    endTime = new Date(endTimeStr).getTime();
                }
            }

            var nowMs = new Date().getTime();
            if (!endTime || isNaN(endTime) || endTime <= nowMs) {
                endTime = getNextSlotEndTime();
            }

            localStorage.setItem('flashSaleTargetEndTime', endTime);

            function updateTimer() {
                var currentNow = new Date().getTime();
                var diff = endTime - currentNow;

                // Nếu đếm ngược hết giờ, tự động lấy mốc tiếp theo để LUÔN CHẠY liên tục
                if (diff <= 0) {
                    endTime = getNextSlotEndTime();
                    localStorage.setItem('flashSaleTargetEndTime', endTime);
                    diff = endTime - currentNow;
                }

                syncFlashSaleUiState();

                var hours = Math.floor(diff / (1000 * 60 * 60));
                var mins = Math.floor((diff % (1000 * 60 * 60)) / (1000 * 60));
                var secs = Math.floor((diff % (1000 * 60)) / 1000);

                var hStr = hours < 10 ? '0' + hours : hours;
                var mStr = mins < 10 ? '0' + mins : mins;
                var sStr = secs < 10 ? '0' + secs : secs;

                document.querySelectorAll('#flashHours, #flashHoursTicker, .flash-h').forEach(function(el){ el.textContent = hStr; });
                document.querySelectorAll('#flashMins, #flashMinutes, #flashMinutesTicker, .flash-m').forEach(function(el){ el.textContent = mStr; });
                document.querySelectorAll('#flashSecs, #flashSeconds, #flashSecondsTicker, .flash-s').forEach(function(el){ el.textContent = sStr; });
            }

            updateTimer();
            setInterval(updateTimer, 1000);
        })();

        // ───── AI DEAL RADAR FETCH ─────
        document.addEventListener('DOMContentLoaded', function() {
            fetch('/PriceTracker/DealRadar')
                .then(function(r) { return r.json(); })
                .then(function(res) {
                    if (res.success && res.items && res.items.length > 0) {
                        var grid = document.getElementById('dealRadarGrid');
                        if (!grid) return;
                        grid.innerHTML = res.items.map(function(item) {
                            var discPercent = Math.round((1 - item.currentPrice / item.highestHistoricalPrice) * 100);
                            return '<div class="tech-card visible" style="background:rgba(255,255,255,0.04); border-color:rgba(255,77,0,0.3); min-height: auto; opacity: 1 !important; visibility: visible !important; transform: none !important;">' +
                                '<div>' +
                                    '<div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:12px;">' +
                                        '<span class="flash-sub-badge" style="background:rgba(0,230,118,0.15); color:#00e676;">SCORE: ' + item.buyScore + '/100</span>' +
                                        '<span style="font-size:11px; color:rgba(255,255,255,0.5); font-weight:700;"><i class="fa fa-arrow-down" style="color:#00e676;"></i> -' + discPercent + '% GIẢM</span>' +
                                    '</div>' +
                                    '<h4 class="tech-card-title" style="font-size:1.05rem; line-height:1.3; height:42px; overflow:hidden; text-overflow:ellipsis; display:-webkit-box; -webkit-line-clamp:2; -webkit-box-orient:vertical; margin-bottom:10px;">' + item.productName + '</h4>' +
                                '</div>' +
                                '<div style="margin-top:10px;">' +
                                    '<div style="font-size:10.5px; color:#ff4d00; font-weight:800; margin-bottom:8px;">' + item.recommendationBadge + '</div>' +
                                    '<div style="display:flex; justify-content:space-between; align-items:baseline; margin-bottom:14px;">' +
                                        '<span style="font-size:17px; font-weight:800; color:#ffffff;">' + item.currentPrice.toLocaleString('vi-VN') + '₫</span>' +
                                        '<span style="font-size:12px; color:rgba(255,255,255,0.4); text-decoration:line-through;">' + item.highestHistoricalPrice.toLocaleString('vi-VN') + '₫</span>' +
                                    '</div>' +
                                    '<a href="/Product/Details/' + item.productId + '" class="btn-hero-primary" style="width:100%; text-align:center; padding:9px; font-size:12px; font-weight:700; background:#ff4d00; color:#fff; border:none; display:block;">' +
                                        '<i class="fa fa-chart-line"></i> Biểu Đồ AI & Mua' +
                                    '</a>' +
                                '</div>' +
                            '</div>';
                        }).join('');
                    }
                })
                .catch(function(err) { console.error('Deal radar error:', err); });
        });

        // ───── MARQUEE PRODUCT SLIDER & SPECS PANEL SCRIPT ─────
        window.selectMarqueeProduct = function(el) {
            if (!el) return;
            document.querySelectorAll('.marquee-card-item').forEach(function(c) { c.classList.remove('active'); });
            el.classList.add('active');

            var id = el.getAttribute('data-id');
            var name = el.getAttribute('data-name');
            var series = el.getAttribute('data-series');
            var price = el.getAttribute('data-price');
            var origPrice = el.getAttribute('data-origprice') || '';
            var img = el.getAttribute('data-img');
            var cpu = el.getAttribute('data-cpu') || 'Intel Core High Performance';
            var ram = el.getAttribute('data-ram') || '16GB DDR5';
            var storage = el.getAttribute('data-storage') || '512GB NVMe SSD';
            var gpu = el.getAttribute('data-gpu') || 'NVIDIA GeForce RTX Graphics';
            var screen = el.getAttribute('data-screen') || 'QHD+ 165Hz / Lumina OLED';

            var tEl = document.getElementById('specTitle');
            var iEl = document.getElementById('specImg');
            var pEl = document.getElementById('specPrice');
            var opEl = document.getElementById('specOrigPrice');
            var cEl = document.getElementById('specCpu');
            var rEl = document.getElementById('specRam');
            var sEl = document.getElementById('specStorage');
            var gEl = document.getElementById('specGpu');
            var scEl = document.getElementById('specScreen');

            if (tEl) tEl.textContent = name;
            if (iEl && img) iEl.src = img;
            if (pEl) pEl.textContent = price;
            if (opEl) opEl.textContent = origPrice;
            if (cEl) cEl.textContent = cpu;
            if (rEl) rEl.textContent = ram;
            if (sEl) sEl.textContent = storage;
            if (gEl) gEl.textContent = gpu;
            if (scEl) scEl.textContent = screen;

            var buyBtn = document.getElementById('specBuyBtn');
            if (buyBtn && id) buyBtn.setAttribute('onclick', 'addToCartAjax(' + id + ', this)');

            var detailBtn = document.getElementById('specDetailBtn');
            if (detailBtn && id) detailBtn.href = '/Product/Details/' + id;
        };

        window.scrollMarquee = function(dir) {
            var track = document.getElementById('marqueeTrack');
            if (track) track.scrollBy({ left: dir * 300, behavior: 'smooth' });
        };

        // Tự động chạy băng rôn sản phẩm liên tục không ngừng (Seamless Continuous Infinite Loop)
        (function() {
            var track = document.getElementById('marqueeTrack');
            if (!track) return;

            track.style.scrollBehavior = 'auto';

            var stepSize = 1;

            var autoTicker = setInterval(function() {
                if (!track) return;

                // Chiều rộng 1 nửa dải sản phẩm (do đã nhân đôi danh sách)
                var halfWidth = track.scrollWidth / 2;
                if (halfWidth > 0 && track.scrollLeft >= halfWidth) {
                    track.scrollLeft -= halfWidth; // Reset giật lùi 1 nửa mượt mà không thể nhận biết bằng mắt
                } else {
                    track.scrollLeft += stepSize;
                }
            }, 22);

            // Hỗ trợ kéo chuột trái mượt mà (Mouse Drag)
            var isDown = false, startX, scrollLeftPos;
            track.addEventListener('mousedown', function(e) {
                isDown = true;
                startX = e.pageX - track.offsetLeft;
                scrollLeftPos = track.scrollLeft;
            });
            track.addEventListener('mouseleave', function() { isDown = false; });
            track.addEventListener('mouseup', function() { isDown = false; });
            track.addEventListener('mousemove', function(e) {
                if (!isDown) return;
                e.preventDefault();
                var x = e.pageX - track.offsetLeft;
                var walk = (x - startX) * 2;
                track.scrollLeft = scrollLeftPos - walk;
            });
        })();

        // Event delegation: Tự động cập nhật thông số khi rê chuột qua bất kỳ item nào
        document.addEventListener('mouseover', function(e) {
            var card = e.target.closest('.marquee-card-item');
            if (card) {
                window.selectMarqueeProduct(card);
            }
        });

        // chuyển đổi video & ảnh nền Asus theo từng dòng sản phẩm
        window.switchHeroBg = function(videoSrc, imgSrc, title, highlight, desc, btn) {
            var video = document.getElementById('heroBgVideo');
            var img = document.getElementById('heroBgImg');
            var heroTitle = document.getElementById('heroTitle');
            var heroHighlight = document.getElementById('heroTitleHighlight');
            var heroSubText = document.getElementById('heroSubText');

            document.querySelectorAll('.hero-series-pill').forEach(function(p) {
                p.classList.remove('active');
            });
            if (btn) btn.classList.add('active');

            if (img && imgSrc) img.src = imgSrc;
            if (heroTitle && imgSrc) {
                heroTitle.style.backgroundImage = "url('" + imgSrc + "')";
            }
            if (video && videoSrc) {
                video.src = videoSrc;
                var playPromise = video.play();
                if (playPromise !== undefined) {
                    playPromise.catch(function(e) {
                        console.log('Video autoplay prevented:', e);
                    });
                }
            }
            if (heroTitle && heroHighlight && title && highlight) {
                heroTitle.childNodes[0].nodeValue = title + ' ';
                heroHighlight.innerText = highlight;
            }
            if (heroSubText && desc) {
                heroSubText.innerText = desc;
            }
        };

        // Tự động chọn item đầu tiên trên băng rôn khi load
        document.addEventListener('DOMContentLoaded', function() {
            var firstItem = document.querySelector('.marquee-card-item');
            if (firstItem) {
                window.selectMarqueeProduct(firstItem);
            }
        });
    </script>

@model List<AsusLaptop.Models.Product>
@{
    ViewData["Title"] = "Laptop ASUS Chính Hãng — ROG, ZenBook, TUF, VivoBook";
    var activeSeries = ViewData["ActiveSeries"]?.ToString() ?? "Tất cả";
    var searchQuery = ViewData["SearchQuery"]?.ToString();
    var activeSort = ViewData["ActiveSort"]?.ToString() ?? "hot";

    var currentPage = (int)(ViewData["CurrentPage"] ?? 1);
    var totalPages = (int)(ViewData["TotalPages"] ?? 1);
    var totalItems = (int)(ViewData["TotalItems"] ?? Model.Count);

    // High quality official ASUS laptop image map
    var fallbackImages = new Dictionary<string, string>
    {
        { "ROG Strix", "https://cdnv2.tgdd.vn/mwg-static/tgdd/Products/Images/44/333095/asus-rog-strix-g16-g614jv-i7-n3515w-1-638700327785084721-750x500.jpg" },
        { "ROG Zephyrus", "https://m.media-amazon.com/images/I/61SEuRLdrYL._AC_UF894,1000_QL80_.jpg" },
        { "ROG Flow", "https://i.rtings.com/assets/products/XiiQ8wbP/asus-rog-flow-x13-2023/design-medium.jpg?format=auto" },
        { "TUF Gaming", "https://vn.store.asus.com/media/catalog/product/cache/2a6b0744b87cbe1990f7a65c1fd3659e/a/s/asus_tuf_gaming_f15_2023__fx507vv-lp304w_1_.jpg" },
        { "ZenBook", "https://cdn.ankhang.vn/media/product/24308_thumb_laptop_asus_zenbook_14_oled_ux3405ma_pp151w.jpg" },
        { "VivoBook", "https://vn.store.asus.com/media/catalog/product/cache/2a6b0744b87cbe1990f7a65c1fd3659e/a/1/a1505va-l1688w.jpg" },
        { "ProArt", "https://vn.store.asus.com/media/catalog/product/cache/6517c62f5899ad6aa0ba23ceb3eeff97/v/i/viber_image_2023-12-15_16-01-02-964.jpg" }
    };
    var defaultImg = "https://cdnv2.tgdd.vn/mwg-static/tgdd/Products/Images/44/333095/asus-rog-strix-g16-g614jv-i7-n3515w-1-638700327785084721-750x500.jpg";

    // Ảnh nền banner — 100% chuẩn sản phẩm ASUS
    const string imgRog     = "/image/rog_bg.png";
    const string imgZen     = "/image/zenbook_bg.png";
    const string imgTuf     = "/image/rog_bg.png";
    const string imgProart  = "/image/rog_bg.png";
    const string imgVivo    = "/image/zenbook_bg.png";

    // Video Laptop thực tế 100% — lưu trực tiếp trong wwwroot/video/ (Không bị chặn CORS / Adblock)
    const string vid1 = "/video/rog_strix.mp4";
    const string vid2 = "/video/zenbook.mp4";
    const string vid3 = "/video/tuf_gaming.mp4";
    const string vid4 = "/video/rog_ecosystem.mp4";
    const string vid5 = "/video/combo_sinhvien.mp4";
}

@section Styles {
    <style>
        /* ═══════════════════════════════════════════
           NIKE-STYLE FULL-BLEED VIDEO HERO CAROUSEL
        ═══════════════════════════════════════════ */

        /* Marquee ticker (giống Nike announcement bar) */
        .nk-marquee-wrap {
            background: #111;
            color: #fff;
            overflow: hidden;
            border-bottom: 1px solid #222;
        }
        .nk-marquee-track {
            display: flex;
            width: max-content;
            animation: nkMarquee 28s linear infinite;
        }
        .nk-marquee-track:hover { animation-play-state: paused; }
        .nk-marquee-item {
            flex-shrink: 0;
            padding: 10px 48px;
            font-size: 12px;
            font-weight: 600;
            letter-spacing: .04em;
            white-space: nowrap;
        }
        .nk-marquee-item a {
            color: #fff;
            text-decoration: underline;
            text-underline-offset: 3px;
        }
        .nk-marquee-item a:hover { opacity: .75; }
        @@keyframes nkMarquee {
            0% { transform: translateX(0); }
            100% { transform: translateX(-50%); }
        }

        /* Full-bleed hero carousel (BANNER CHÍNH SIÊU LỚN) */
        .nk-hero-carousel {
            position: relative;
            width: 100%;
            height: clamp(680px, 92vh, 960px);
            background: #111;
            overflow: hidden;
        }

        .hero-slider-track {
            position: relative;
            width: 100%;
            height: 100%;
        }

        .hero-slide {
            position: absolute;
            inset: 0;
            opacity: 0;
            visibility: hidden;
            transition: opacity .85s ease, visibility .85s ease;
            z-index: 1;
        }
        .hero-slide.active {
            opacity: 1;
            visibility: visible;
            z-index: 2;
        }

        .hero-slide-bg {
            position: absolute;
            inset: 0;
            overflow: hidden;
            background-size: cover;
            background-position: center;
            background-color: #1a1a1a;
        }

        /* Lớp ảnh nền luôn hiển thị — video chỉ là lớp phủ tùy chọn */
        .banner-bg-img,
        .hero-fallback-img {
            position: absolute;
            inset: 0;
            width: 100%;
            height: 100%;
            object-fit: cover;
            object-position: center;
            z-index: 0;
        }

        .hero-banner-video,
        .sub-banner-video,
        .mid-banner-video,
        .nk-full-banner-video,
        .visible-video-card video {
            position: absolute;
            inset: 0;
            width: 100%;
            height: 100%;
            object-fit: cover;
            object-position: center;
            z-index: 1;
            opacity: 1 !important;
            display: block !important;
            visibility: visible !important;
            transition: transform 8s ease, opacity .5s ease;
        }

        .hero-slide.active .hero-banner-video.banner-video-ready {
            transform: scale(1);
        }

        .hero-banner-video.banner-video-ready {
            transform: scale(1.04);
            transition: transform 8s ease, opacity .5s ease;
        }
        .hero-slide-overlay {
            position: absolute;
            inset: 0;
            z-index: 2;
            background: linear-gradient(
                to top,
                rgba(0,0,0,0.72) 0%,
                rgba(0,0,0,0.35) 35%,
                rgba(0,0,0,0.08) 70%,
                rgba(0,0,0,0) 100%
            );
        }

        .hero-slide-content {
            position: absolute;
            bottom: 0;
            left: 0;
            right: 0;
            z-index: 3;
            padding: 0 clamp(24px, 5vw, 64px) clamp(72px, 8vw, 96px);
            color: #fff;
            max-width: 680px;
        }

        .hero-badge-tag {
            font-size: 12px;
            font-weight: 600;
            letter-spacing: .02em;
            margin-bottom: 8px;
            display: block;
            opacity: .9;
        }

        .hero-slide-title {
            font-family: 'Barlow Condensed', 'Helvetica Neue', Helvetica, Arial, sans-serif;
            font-size: clamp(2.4rem, 5.5vw, 4.5rem);
            font-weight: 800;
            line-height: 1;
            text-transform: uppercase;
            margin-bottom: 20px;
            letter-spacing: -.02em;
        }

        .hero-slide-sub { display: none; }

        .hero-actions {
            display: flex;
            gap: 12px;
            flex-wrap: wrap;
        }

        /* Nút CTA kiểu Nike: tròn, tối giản */
        .btn-hero-primary,
        .btn-hero-glass {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            min-width: 110px;
            padding: 12px 24px;
            border-radius: 999px;
            font-weight: 600;
            font-size: 14px;
            text-decoration: none;
            transition: background .2s ease, color .2s ease, border-color .2s ease;
        }
        .btn-hero-primary,
        .btn-rog, .btn-zen, .btn-tuf, .btn-proart {
            background: #fff;
            color: #111;
            border: 1.5px solid #fff;
        }
        .btn-hero-primary:hover,
        .btn-rog:hover, .btn-zen:hover, .btn-tuf:hover, .btn-proart:hover {
            background: rgba(255,255,255,.85);
        }
        .btn-hero-glass {
            background: transparent;
            color: #fff;
            border: 1.5px solid rgba(255,255,255,.8);
        }
        .btn-hero-glass:hover {
            background: rgba(255,255,255,.12);
            border-color: #fff;
        }

        /* Mũi tên điều hướng */
        .slider-arrow {
            position: absolute;
            top: 50%;
            transform: translateY(-50%);
            z-index: 10;
            width: 40px;
            height: 40px;
            border-radius: 50%;
            background: rgba(255,255,255,.15);
            border: none;
            color: #fff;
            font-size: 14px;
            display: flex;
            align-items: center;
            justify-content: center;
            cursor: pointer;
            backdrop-filter: blur(6px);
            transition: background .2s ease;
            opacity: 0;
        }
        .nk-hero-carousel:hover .slider-arrow { opacity: 1; }
        .slider-arrow:hover { background: rgba(255,255,255,.35); }
        .slider-prev { left: clamp(12px, 2vw, 28px); }
        .slider-next { right: clamp(12px, 2vw, 28px); }

        /* Thanh progress kiểu Nike */
        .slider-dots {
            position: absolute;
            bottom: clamp(20px, 3vw, 36px);
            left: 50%;
            transform: translateX(-50%);
            z-index: 10;
            display: flex;
            gap: 6px;
            align-items: center;
            width: min(320px, 70vw);
        }
        .slider-dot {
            flex: 1;
            height: 3px;
            border-radius: 2px;
            background: rgba(255,255,255,.35);
            border: none;
            cursor: pointer;
            padding: 0;
            overflow: hidden;
            position: relative;
        }
        .slider-dot::after {
            content: '';
            position: absolute;
            left: 0; top: 0;
            height: 100%;
            width: 0%;
            background: #fff;
            border-radius: 2px;
        }
        .slider-dot.active::after {
            animation: nkProgress var(--slide-duration, 6s) linear forwards;
        }
        .slider-dot.done::after { width: 100%; animation: none; }
        @@keyframes nkProgress {
            from { width: 0%; }
            to { width: 100%; }
        }

        /* Dual promo banners (2 cột — giống Nike split hero) */
        .nk-dual-promo {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 0;
        }
        @@media (max-width: 768px) {
            .nk-dual-promo { grid-template-columns: 1fr; }
        }

        .sub-banner-card {
            position: relative;
            min-height: clamp(380px, 50vw, 560px);
            overflow: hidden;
            display: flex;
            flex-direction: column;
            justify-content: flex-end;
            color: #fff;
            text-decoration: none;
            background-color: #1a1a1a;
            background-size: cover;
            background-position: center;
        }
        .sub-banner-card:hover .sub-banner-video:not(.banner-video-hidden) { transform: scale(1.03); }

        .sub-banner-video {
            transition: transform .6s ease;
        }
        .sub-banner-card::before {
            content: '';
            position: absolute;
            inset: 0;
            z-index: 2;
            background: linear-gradient(to top, rgba(0,0,0,.75) 0%, rgba(0,0,0,.2) 50%, transparent 100%);
        }

        .sub-banner-content {
            position: relative;
            z-index: 3;
            padding: clamp(24px, 4vw, 48px);
        }
        .sub-banner-badge { display: none; }

        .sub-banner-title {
            font-family: 'Barlow Condensed', sans-serif;
            font-size: clamp(1.6rem, 3vw, 2.4rem);
            font-weight: 800;
            text-transform: uppercase;
            line-height: 1.05;
            margin-bottom: 16px;
        }

        .sub-banner-desc { display: none; }

        .sub-banner-link {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            padding: 11px 22px;
            border-radius: 999px;
            background: #fff;
            color: #111;
            font-size: 14px;
            font-weight: 600;
            transition: background .2s ease;
        }
        .sub-banner-card:hover .sub-banner-link { background: rgba(255,255,255,.85); }

        /* Full-width editorial banner (Nike style) */
        .nk-full-banner {
            position: relative;
            min-height: clamp(400px, 55vw, 620px);
            overflow: hidden;
            display: flex;
            align-items: flex-end;
            background-color: #1a1a1a;
            background-size: cover;
            background-position: center;
            text-decoration: none;
            color: #fff;
        }
        .nk-full-banner:hover .nk-full-banner-video:not(.banner-video-hidden) { transform: scale(1.02); }
        .nk-full-banner-video {
            transition: transform .6s ease;
        }
        .nk-full-banner::before {
            content: '';
            position: absolute;
            inset: 0;
            z-index: 2;
            background: linear-gradient(to top, rgba(0,0,0,.8) 0%, rgba(0,0,0,.25) 50%, transparent 100%);
        }
        .nk-full-banner-content {
            position: relative;
            z-index: 3;
            padding: clamp(32px, 5vw, 64px);
            max-width: 560px;
        }
        .nk-full-banner-eyebrow {
            font-size: 12px;
            font-weight: 600;
            letter-spacing: .04em;
            margin-bottom: 8px;
            opacity: .9;
        }
        .nk-full-banner-title {
            font-family: 'Barlow Condensed', sans-serif;
            font-size: clamp(2rem, 4.5vw, 3.5rem);
            font-weight: 800;
            text-transform: uppercase;
            line-height: 1;
            margin-bottom: 20px;
        }
        .nk-full-banner-btn {
            display: inline-flex;
            padding: 12px 24px;
            border-radius: 999px;
            background: #fff;
            color: #111;
            font-size: 14px;
            font-weight: 600;
        }
        .nk-full-banner:hover .nk-full-banner-btn { background: rgba(255,255,255,.85); }

        /* Copilot / service CTA strip */
        .nk-copilot-banner {
            background: #111;
            color: #fff;
            padding: clamp(48px, 6vw, 72px) clamp(24px, 5vw, 64px);
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 24px;
            flex-wrap: wrap;
        }
        .nk-copilot-banner h3 {
            font-family: 'Barlow Condensed', sans-serif;
            font-size: clamp(1.6rem, 3vw, 2.4rem);
            font-weight: 800;
            text-transform: uppercase;
            margin-bottom: 8px;
        }
        .nk-copilot-banner p {
            font-size: 14px;
            color: rgba(255,255,255,.75);
            max-width: 520px;
        }
        .nk-copilot-btn {
            display: inline-flex;
            align-items: center;
            gap: 8px;
            padding: 14px 28px;
            border-radius: 999px;
            background: #fff;
            color: #111;
            font-weight: 600;
            font-size: 14px;
            text-decoration: none;
            white-space: nowrap;
            transition: background .2s ease;
        }
        .nk-copilot-btn:hover { background: rgba(255,255,255,.85); }

        /* Flash sale section container */
        .nk-flash-section {
            max-width: 1400px;
            margin: 0 auto;
            padding: 32px 2rem 0;
        }

        /* 2. FLASH SALE TICKER BANNER */
        .flash-sale-banner {
            max-width: 1400px;
            margin: 48px auto 0;
            padding: 0 2rem;
        }

        .flash-sale-inner {
            background: #111;
            border: 1px solid rgba(255,255,255,0.1);
            border-radius: 16px;
            padding: 20px 32px;
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 20px;
            box-shadow: 0 12px 35px rgba(0,0,0,0.25);
            flex-wrap: wrap;
            position: relative;
            overflow: hidden;
        }

        .flash-sale-inner::before {
            content: '';
            position: absolute;
            top: 0; left: -100%;
            width: 100%; height: 100%;
            background: linear-gradient(90deg, transparent, rgba(255,255,255,0.08), transparent);
            animation: flashShimmer 3.5s infinite;
        }

        @@keyframes flashShimmer {
            100% { left: 100%; }
        }

        .flash-left {
            display: flex;
            align-items: center;
            gap: 14px;
        }

        .flash-icon-box {
            width: 46px;
            height: 46px;
            border-radius: 14px;
            background: linear-gradient(135deg, #ff4d00, #ff0055);
            color: #fff;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 22px;
            box-shadow: 0 4px 18px rgba(255,77,0,0.55);
            animation: pulseGlow 1.8s infinite alternate;
        }

        @@keyframes pulseGlow {
            0% { transform: scale(1); box-shadow: 0 4px 18px rgba(255,77,0,0.55); }
            100% { transform: scale(1.08); box-shadow: 0 8px 28px rgba(255,77,0,0.85); }
        }

        .flash-title {
            font-family: 'Barlow Condensed', sans-serif;
            font-size: 1.45rem;
            font-weight: 800;
            color: #ffffff;
            text-transform: uppercase;
            letter-spacing: .02em;
            margin: 0;
        }

        .flash-sub {
            font-size: 12.5px;
            color: rgba(255,255,255,0.78);
        }

        /* FLASH SALE SECTION STYLES */
        .flash-sale-wrapper {
            background: linear-gradient(135deg, #11131a 0%, #1a0b16 100%);
            border: 1px solid rgba(255, 77, 0, 0.4);
            border-radius: 24px;
            padding: 24px;
            margin-bottom: 2.5rem;
            box-shadow: 0 16px 40px rgba(255, 77, 0, 0.15);
            color: #ffffff;
        }
        .flash-sale-header {
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 16px;
            margin-bottom: 20px;
            flex-wrap: wrap;
            border-bottom: 1px solid rgba(255, 255, 255, 0.1);
            padding-bottom: 16px;
        }
        .flash-title-wrap { display: flex; align-items: center; gap: 12px; }
        .flash-fire-icon { font-size: 32px; animation: pulseFire 1.2s infinite alternate; }
        @@keyframes pulseFire { 0% { transform: scale(1); } 100% { transform: scale(1.15); } }
        .flash-main-title { font-family: 'Barlow Condensed', sans-serif; font-size: 28px; font-weight: 800; margin: 0; color: #ffffff; letter-spacing: 0.5px; }
        .flash-sub-badge { font-size: 11px; font-weight: 800; color: #ff4d00; background: rgba(255, 77, 0, 0.15); padding: 3px 10px; border-radius: 999px; letter-spacing: 0.5px; }
        .flash-timer-container { display: flex; align-items: center; gap: 12px; }
        .flash-timer-label { font-size: 11px; font-weight: 800; color: rgba(255, 255, 255, 0.7); letter-spacing: 0.5px; }
        .flash-timer-box { display: flex; align-items: center; gap: 8px; }
        .timer-unit { background: #0a0b10; border: 1px solid rgba(255,77,0,0.55); border-radius: 10px; padding: 6px 12px; min-width: 46px; text-align: center; }
        .timer-num { font-family: 'Barlow Condensed', sans-serif; font-size: 1.45rem; font-weight: 800; color: #ff4d00; line-height: 1; }
        .timer-lbl { font-size: 9.5px; color: #999; text-transform: uppercase; font-weight: 700; }
        .timer-colon { font-weight: 800; color: #ff4d00; font-size: 1.3rem; }

        .flash-products-grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 16px; }
        @@media (max-width: 1024px) { .flash-products-grid { grid-template-columns: repeat(2, 1fr); } }
        @@media (max-width: 580px) { .flash-products-grid { grid-template-columns: 1fr; } }
        .flash-card {
            background: rgba(255, 255, 255, 0.04);
            border: 1px solid rgba(255, 255, 255, 0.1);
            border-radius: 16px;
            padding: 16px;
            position: relative;
            transition: all 0.3s ease;
            display: flex;
            flex-direction: column;
            justify-content: space-between;
        }
        .flash-card:hover { transform: translateY(-6px); border-color: #ff4d00; box-shadow: 0 12px 30px rgba(255, 77, 0, 0.25); background: rgba(255, 255, 255, 0.07); }
        .flash-card-badge { position: absolute; top: 12px; left: 12px; z-index: 5; background: linear-gradient(135deg, #e00034, #ff4d00); color: #fff; font-size: 12px; font-weight: 800; padding: 4px 10px; border-radius: 8px; box-shadow: 0 4px 12px rgba(224, 0, 52, 0.4); }
        .flash-card-img-wrap { display: block; height: 150px; text-align: center; margin-bottom: 12px; background: #fff; border-radius: 12px; padding: 8px; }
        .flash-card-img { width: 100%; height: 100%; object-fit: contain; }
        .flash-series-tag { font-size: 10px; font-weight: 800; color: #ff4d00; text-transform: uppercase; letter-spacing: 0.5px; }
        .flash-prod-title { font-size: 14px; font-weight: 700; margin: 4px 0 10px; line-height: 1.3; height: 36px; overflow: hidden; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; }
        .flash-prod-title a { color: #ffffff; text-decoration: none; }
        .flash-prod-title a:hover { color: #ff4d00; }
        .flash-price-wrap { display: flex; align-items: baseline; gap: 8px; margin-bottom: 10px; }
        .flash-price { font-size: 16px; font-weight: 800; color: #ff4d00; }
        .flash-orig-price { font-size: 12px; color: rgba(255, 255, 255, 0.5); text-decoration: line-through; }
        .flash-progress-bar { position: relative; height: 18px; background: rgba(255, 255, 255, 0.1); border-radius: 999px; overflow: hidden; margin-bottom: 12px; }
        .flash-progress-fill { position: absolute; top: 0; left: 0; bottom: 0; background: linear-gradient(90deg, #ff4d00, #ff8800); border-radius: 999px; }
        .flash-progress-text { position: absolute; inset: 0; display: flex; align-items: center; justify-content: center; font-size: 10px; font-weight: 800; color: #fff; text-shadow: 0 1px 3px rgba(0,0,0,0.8); z-index: 2; }
        .flash-buy-btn { width: 100%; padding: 10px; border-radius: 10px; background: linear-gradient(135deg, #ff4d00, #e00034); color: #fff; font-size: 13px; font-weight: 800; border: none; cursor: pointer; transition: all 0.2s ease; }
        .flash-buy-btn:hover { opacity: 0.9; transform: scale(1.02); }
        .flash-buy-btn.disabled, .flash-buy-btn[disabled] { background: #2a2b32 !important; color: #888888 !important; cursor: not-allowed !important; opacity: 0.7; box-shadow: none !important; transform: none !important; }

        /* 3. SHOP BY SERIES VISUAL BANNERS GRID WITH HIGH-RES IMAGES */
        .series-banners-section {
            max-width: 1400px;
            margin: 48px auto 0;
            padding: 0 2rem;
        }

        .section-header-title {
            font-family: 'Barlow Condensed', sans-serif;
            font-size: 1.5rem;
            font-weight: 800;
            text-transform: uppercase;
            color: #111;
            margin-bottom: 18px;
            letter-spacing: -.01em;
        }

        .series-banner-grid {
            display: grid;
            grid-template-columns: repeat(5, 1fr);
            gap: 16px;
        }

        @@media (max-width: 1100px) {
            .series-banner-grid { grid-template-columns: repeat(3, 1fr); }
        }

        @@media (max-width: 640px) {
            .series-banner-grid { grid-template-columns: repeat(2, 1fr); }
        }


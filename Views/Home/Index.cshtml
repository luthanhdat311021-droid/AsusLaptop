<!-- ═══════════════════════════════════════════
   BĂNG RÔN SẢN PHẨM MARQUEE + KHUNG THÔNG SỐ BÊN PHẢI
═══════════════════════════════════════════ -->
<section class="marquee-showcase-section" id="marqueeShowcase" style="max-width:1400px; margin:36px auto 0; padding:0 2rem;">
    <div class="landing-section-header reveal" style="text-align:left; margin-bottom:20px;">
        <span class="landing-section-tag"><i class="fa-solid fa-layer-group"></i> Băng Rôn Sản Phẩm Flagship</span>
        <h2 class="landing-section-title" style="margin-bottom:4px;">🔥 Chạm Để Xem Chi Tiết Thông Số Kỹ Thuật</h2>
        <p class="landing-section-sub">Bấm vào bất kỳ mẫu laptop trên băng rôn để xem ngay cấu hình chi tiết ở khung bên phải.</p>
    </div>

    <div class="marquee-interactive-container reveal">
        <!-- LEFT: BĂNG RÔN SẢN PHẨM MARQUEE SLIDER -->
        <div class="marquee-track-wrapper">
            <div class="marquee-controls-row">
                <button type="button" class="marquee-nav-btn" onclick="scrollMarquee(-1)"><i class="fa fa-chevron-left"></i></button>
                <span class="marquee-hint"><i class="fa-solid fa-hand-pointer"></i> Bấm chọn laptop bên dưới để xem cấu hình</span>
                <button type="button" class="marquee-nav-btn" onclick="scrollMarquee(1)"><i class="fa fa-chevron-right"></i></button>
            </div>

            <div class="marquee-cards-track" id="marqueeTrack">
                @if (Model != null && Model.Count > 0)
                {
                    @* TẬP SẢN PHẨM GỐC *@
                    foreach (var p in Model)
                    {
                        var imgUrl = string.IsNullOrEmpty(p.ImageUrl) ? fallbackImages.GetValueOrDefault(p.Series, defaultImg) : p.ImageUrl;
                        <div class="marquee-card-item" 
                             onmouseenter="window.selectMarqueeProduct(this)"
                             onclick="window.selectMarqueeProduct(this)"
                             data-id="@p.Id"
                             data-name="@p.Name"
                             data-series="@p.Series"
                             data-price="@p.Price.ToString("N0")₫"
                             data-origprice="@(p.OriginalPrice > p.Price ? p.OriginalPrice.ToString("N0") + "₫" : "")"
                             data-img="@imgUrl"
                             data-cpu="@p.CPU"
                             data-ram="@p.RAM"
                             data-storage="@p.Storage"
                             data-gpu="@p.GPU"
                             data-screen="@p.ScreenSize"
                             data-weight="@p.Weight"
                             data-desc="@p.Description">
                            <div class="marquee-img-wrap">
                                <img src="@imgUrl" alt="@p.Name" loading="lazy" />
                            </div>
                            <div class="marquee-item-info">
                                <span class="marquee-series-badge">@p.Series</span>
                                <h4 class="marquee-item-title">@p.Name</h4>
                                <div class="marquee-item-price">@p.Price.ToString("N0")₫</div>
                            </div>
                        </div>
                    }

                    @* TẬP SẢN PHẨM NHÂN ĐÔI ĐỂ TẠO VÒNG LẶP VÔ TẬN SEAMLESS ĐỊNH DẠNG KHÔNG KHỰNG NHỊP *@
                    foreach (var p in Model)
                    {
                        var imgUrl = string.IsNullOrEmpty(p.ImageUrl) ? fallbackImages.GetValueOrDefault(p.Series, defaultImg) : p.ImageUrl;
                        <div class="marquee-card-item marquee-card-clone" 
                             onmouseenter="window.selectMarqueeProduct(this)"
                             onclick="window.selectMarqueeProduct(this)"
                             data-id="@p.Id"
                             data-name="@p.Name"
                             data-series="@p.Series"
                             data-price="@p.Price.ToString("N0")₫"
                             data-origprice="@(p.OriginalPrice > p.Price ? p.OriginalPrice.ToString("N0") + "₫" : "")"
                             data-img="@imgUrl"
                             data-cpu="@p.CPU"
                             data-ram="@p.RAM"
                             data-storage="@p.Storage"
                             data-gpu="@p.GPU"
                             data-screen="@p.ScreenSize"
                             data-weight="@p.Weight"
                             data-desc="@p.Description">
                            <div class="marquee-img-wrap">
                                <img src="@imgUrl" alt="@p.Name" loading="lazy" />
                            </div>
                            <div class="marquee-item-info">
                                <span class="marquee-series-badge">@p.Series</span>
                                <h4 class="marquee-item-title">@p.Name</h4>
                                <div class="marquee-item-price">@p.Price.ToString("N0")₫</div>
                            </div>
                        </div>
                    }
                }
            </div>
        </div>

        <!-- RIGHT: KHUNG HIỂN THỊ THÔNG SỐ KỸ THUẬT BÊN PHẢI -->
        <div class="specs-side-panel" id="specsSidePanel">

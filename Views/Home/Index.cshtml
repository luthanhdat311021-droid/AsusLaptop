<!-- ═══════════════════════════════════════════
   DANH SÁCH SẢN PHẨM & PHÂN TRANG (PRODUCTS GRID)
═══════════════════════════════════════════ -->
<section class="nk-page" id="productsSection">
    <div class="nk-page-header reveal">
        <h2 class="nk-page-title">
            @(activeSeries != "Tất cả" ? $"Dòng Sản Phẩm {activeSeries}" : (!string.IsNullOrEmpty(searchQuery) ? $"Kết quả tìm kiếm: \"{searchQuery}\"" : "Tất Cả Sản Phẩm Laptop"))
        </h2>
        <span class="nk-page-count">Hiển thị @Model.Count / @totalItems sản phẩm</span>
    </div>

    <!-- FILTER & SORT TOOLBAR -->
    <div class="nk-toolbar reveal">
        <div class="nk-toolbar-filters">
            <span class="nk-filter-label"><i class="fa fa-filter"></i> Dòng sản phẩm:</span>
            <a href="/?series=Tất cả" class="nk-chip @(activeSeries == "Tất cả" ? "active" : "")">Tất cả</a>
            @if (ViewBag.SeriesList != null)
            {
                foreach (string s in (List<string>)ViewBag.SeriesList)
                {
                    if (!string.IsNullOrEmpty(s))
                    {
                        <a href="/?series=@Uri.EscapeDataString(s)&sort=@activeSort" class="nk-chip @(activeSeries == s ? "active" : "")">@s</a>
                    }
                }
            }
        </div>

        <div style="display:flex; align-items:center; gap:10px;">
            <label for="sortSelect" class="nk-filter-label" style="margin:0;"><i class="fa fa-sort"></i> Sắp xếp:</label>
            <select id="sortSelect" class="nk-sort-select" onchange="location = this.value;">
                <option value="/?series=@Uri.EscapeDataString(activeSeries)&search=@Uri.EscapeDataString(searchQuery ?? "")&sort=hot" selected="@(activeSort == "hot")">Nổi bật / Hot nhất</option>
                <option value="/?series=@Uri.EscapeDataString(activeSeries)&search=@Uri.EscapeDataString(searchQuery ?? "")&sort=newest" selected="@(activeSort == "newest")">Mới nhất</option>
                <option value="/?series=@Uri.EscapeDataString(activeSeries)&search=@Uri.EscapeDataString(searchQuery ?? "")&sort=price_asc" selected="@(activeSort == "price_asc")">Giá tăng dần</option>
                <option value="/?series=@Uri.EscapeDataString(activeSeries)&search=@Uri.EscapeDataString(searchQuery ?? "")&sort=price_desc" selected="@(activeSort == "price_desc")">Giá giảm dần</option>
                <option value="/?series=@Uri.EscapeDataString(activeSeries)&search=@Uri.EscapeDataString(searchQuery ?? "")&sort=name" selected="@(activeSort == "name")">Tên A-Z</option>
            </select>
        </div>
    </div>

    <!-- AI RECOMMENDATIONS (Khi đăng nhập & có dữ liệu) -->
    @if (ViewBag.PersonalizedRecommendations != null)
    {
        var recs = ViewBag.PersonalizedRecommendations as List<AsusLaptop.Models.Product>;
        if (recs != null && recs.Count > 0)
        {
            <div class="personalized-ai reveal">
                <div class="personalized-ai-head">
                    <div>
                        <span class="personalized-ai-label">🤖 AI GỢI Ý DÀNH RIÊNG CHO BẠN</span>
                        <h2>Sản phẩm phù hợp nhất</h2>
                    </div>
                </div>
                <div class="personalized-ai-list">
                    @foreach (var rec in recs.Take(3))
                    {
                        <a href="/Product/Details/@rec.Id" class="personalized-ai-item">
                            <img src="@(string.IsNullOrEmpty(rec.ImageUrl) ? fallbackImages.GetValueOrDefault(rec.Series, defaultImg) : rec.ImageUrl)" alt="@rec.Name" />
                            <div class="personalized-ai-info">
                                <strong>@rec.Name</strong>
                                <small>@rec.Series | @rec.CPU</small>
                                <b>@rec.Price.ToString("N0")₫</b>
                            </div>
                        </a>
                    }
                </div>
            </div>
        }
    }

    <!-- PRODUCT GRID -->
    @if (Model != null && Model.Count > 0)
    {
        <div class="products-grid reveal-grid">
            @foreach (var p in Model)
            {
                var imgUrl = string.IsNullOrEmpty(p.ImageUrl) ? fallbackImages.GetValueOrDefault(p.Series, defaultImg) : p.ImageUrl;
                bool isSale = p.OriginalPrice > p.Price;
                int discPercent = isSale ? (int)Math.Round((p.OriginalPrice - p.Price) / p.OriginalPrice * 100) : 0;

                <div class="product-card reveal" onclick="window.location.href='/Product/Details/@p.Id'">
                    @if (isSale)
                    {
                        <span class="product-badge badge-sale">-@discPercent%</span>
                    }
                    else if (p.ViewCount > 50)
                    {
                        <span class="product-badge badge-hot">HOT</span>
                    }

                    <button type="button" class="product-wish" title="Yêu thích" onclick="event.stopPropagation(); addToWishlistAjax(@p.Id, this)">
                        <i class="fa-regular fa-heart"></i>
                    </button>

                    @if (User.IsInRole("Admin") || User.IsInRole("SubAdmin"))
                    {
                        <a href="/Admin/Product/Edit/@p.Id" class="product-edit-btn" title="Sửa sản phẩm" onclick="event.stopPropagation();">
                            <i class="fa fa-pen"></i>
                        </a>
                    }

                    <div class="product-img">
                        <img src="@imgUrl" alt="@p.Name" loading="lazy" />
                        <div class="product-quickview">
                            <span><i class="fa fa-eye"></i> Xem chi tiết</span>
                        </div>
                    </div>

                    <div class="product-body">
                        <div class="product-series">@p.Series</div>
                        <a href="/Product/Details/@p.Id" class="product-name" title="@p.Name" onclick="event.stopPropagation();">@p.Name</a>

                        <div class="product-specs">
                            @if (!string.IsNullOrEmpty(p.CPU)) { <span class="spec-tag"><i class="fa fa-microchip"></i> @p.CPU</span> }
                            @if (!string.IsNullOrEmpty(p.RAM)) { <span class="spec-tag"><i class="fa fa-memory"></i> @p.RAM</span> }
                            @if (!string.IsNullOrEmpty(p.Storage)) { <span class="spec-tag"><i class="fa fa-hard-drive"></i> @p.Storage</span> }
                        </div>

                        <div class="product-footer">
                            <div class="product-price-row">
                                <span class="product-price">@p.Price.ToString("N0")₫</span>
                                @if (isSale)
                                {
                                    <span class="product-original">@p.OriginalPrice.ToString("N0")₫</span>
                                }
                            </div>
                            <div class="product-actions">
                                <button type="button" class="btn-add-cart" onclick="event.stopPropagation(); addToCartAjax(@p.Id, this)">
                                    <i class="fa fa-cart-plus"></i> Thêm giỏ hàng
                                </button>
                                <a href="/Product/Details/@p.Id" class="btn-detail" title="Xem chi tiết" onclick="event.stopPropagation();">
                                    <i class="fa fa-arrow-right"></i>
                                </a>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>

        <!-- PAGINATION -->
        @if (totalPages > 1)
        {
            <div class="nk-pagination reveal">
                <a href="/?series=@Uri.EscapeDataString(activeSeries)&search=@Uri.EscapeDataString(searchQuery ?? "")&sort=@activeSort&page=@(currentPage - 1)"
                   class="page-btn @(currentPage <= 1 ? "disabled" : "")">
                    <i class="fa fa-chevron-left"></i> Trang trước
                </a>

                <div class="page-numbers">
                    @for (int i = 1; i <= totalPages; i++)
                    {
                        <a href="/?series=@Uri.EscapeDataString(activeSeries)&search=@Uri.EscapeDataString(searchQuery ?? "")&sort=@activeSort&page=@i"
                           class="page-num @(i == currentPage ? "active" : "")">@i</a>
                    }
                </div>

                <a href="/?series=@Uri.EscapeDataString(activeSeries)&search=@Uri.EscapeDataString(searchQuery ?? "")&sort=@activeSort&page=@(currentPage + 1)"
                   class="page-btn @(currentPage >= totalPages ? "disabled" : "")">
                    Trang sau <i class="fa fa-chevron-right"></i>
                </a>
            </div>
        }
    }
    else
    {
        <div class="empty-state reveal">
            <i class="fa fa-laptop"></i>
            <h3>Không tìm thấy sản phẩm nào</h3>
            <p>Rất tiếc, hiện tại không có sản phẩm nào thuộc bộ lọc này.</p>
            <a href="/" class="cta-primary"><i class="fa fa-refresh"></i> Xem tất cả sản phẩm</a>
        </div>
    }
</section>


        .personalized-ai-list { display:grid; grid-template-columns:repeat(3, minmax(0, 1fr)); gap:10px; }
        .personalized-ai-item { display:flex; min-width:0; gap:9px; align-items:center; padding:9px; border-radius:11px; background:#fff; border:1px solid #f0e6e1; text-decoration:none; color:inherit; transition:transform .2s, box-shadow .2s; }
        .personalized-ai-item:hover { transform:translateY(-2px); box-shadow:0 5px 14px rgba(0,0,0,.08); }
        .personalized-ai-item img { width:52px; height:52px; object-fit:cover; border-radius:8px; background:#f4f4f4; }

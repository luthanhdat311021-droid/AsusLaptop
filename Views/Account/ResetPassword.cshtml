@{
    ViewData["Title"] = "Đặt lại mật khẩu";
    Layout = "_Layout";
    var email = ViewBag.Email as string ?? "";
}

<div class="auth-wrap">
    <div class="auth-card">
        <div class="auth-header">
            <div class="auth-logo">
                <span class="logo-asus" style="font-size:32px">ASUS</span>
            </div>
            <h2 class="auth-title">Mật khẩu mới</h2>
            <p class="auth-subtitle">
                Đặt mật khẩu mới cho tài khoản<br>
                <strong style="color:var(--accent)">@email</strong>
            </p>
        </div>

        @if (!ViewData.ModelState.IsValid)
        {
            <div class="alert alert-danger">
                <i class="fa fa-exclamation-circle"></i>
                <div>
                    @foreach (var error in ViewData.ModelState.Values.SelectMany(v => v.Errors))
                    {
                        <div>@error.ErrorMessage</div>
                    }
                </div>
            </div>
        }

        <!-- Step indicator -->
        <div style="display:flex;align-items:center;gap:0;margin-bottom:24px">
            <div style="flex:1;text-align:center">
                <div style="width:32px;height:32px;border-radius:50%;background:rgba(0,212,255,0.2);color:var(--accent);font-weight:700;font-size:14px;display:flex;align-items:center;justify-content:center;margin:0 auto 4px">✓</div>
                <div style="font-size:11px;color:var(--text-muted)">Nhập email</div>
            </div>
            <div style="flex:1;height:2px;background:var(--accent)"></div>
            <div style="flex:1;text-align:center">
                <div style="width:32px;height:32px;border-radius:50%;background:rgba(0,212,255,0.2);color:var(--accent);font-weight:700;font-size:14px;display:flex;align-items:center;justify-content:center;margin:0 auto 4px">✓</div>
                <div style="font-size:11px;color:var(--text-muted)">Xác thực OTP</div>
            </div>
            <div style="flex:1;height:2px;background:var(--accent)"></div>
            <div style="flex:1;text-align:center">
                <div style="width:32px;height:32px;border-radius:50%;background:var(--accent);color:#fff;font-weight:700;font-size:14px;display:flex;align-items:center;justify-content:center;margin:0 auto 4px">3</div>
                <div style="font-size:11px;color:var(--accent)">Mật khẩu mới</div>
            </div>
        </div>

        <form asp-action="ResetPassword" method="post">
            @Html.AntiForgeryToken()

            <div class="form-group" style="margin-bottom:14px">
                <label class="form-label">Mật khẩu mới</label>
                <div class="input-icon-wrap">
                    <i class="fa fa-lock fi"></i>
                    <input type="password" name="newPassword" id="newPassInput" class="form-control"
                           placeholder="Tối thiểu 6 ký tự" required minlength="6" />
                    <button type="button" onclick="togglePass('newPassInput','eyeNew')"
                        style="position:absolute;right:12px;top:50%;transform:translateY(-50%);color:var(--text-muted);font-size:14px;background:none;border:none;cursor:pointer">
                        <i class="fa fa-eye" id="eyeNew"></i>
                    </button>
                </div>
                <!-- Password strength bar -->
                <div style="margin-top:8px">
                    <div style="height:4px;border-radius:2px;background:var(--border);overflow:hidden">
                        <div id="strengthBar" style="height:100%;width:0;transition:width .3s,background .3s;border-radius:2px"></div>
                    </div>
                    <div id="strengthText" style="font-size:11px;color:var(--text-muted);margin-top:4px"></div>
                </div>
            </div>

            <div class="form-group" style="margin-bottom:20px">
                <label class="form-label">Xác nhận mật khẩu</label>
                <div class="input-icon-wrap">
                    <i class="fa fa-lock fi"></i>
                    <input type="password" name="confirmPassword" id="confirmPassInput" class="form-control"
                           placeholder="Nhập lại mật khẩu" required />
                    <button type="button" onclick="togglePass('confirmPassInput','eyeConfirm')"
                        style="position:absolute;right:12px;top:50%;transform:translateY(-50%);color:var(--text-muted);font-size:14px;background:none;border:none;cursor:pointer">
                        <i class="fa fa-eye" id="eyeConfirm"></i>
                    </button>
                </div>
                <div id="matchMsg" style="font-size:12px;margin-top:6px"></div>
            </div>

            <button type="submit" class="btn-submit">
                <i class="fa fa-shield-alt"></i> Đặt lại mật khẩu
            </button>
        </form>

        <div class="auth-footer" style="margin-top:16px">
            <a href="/Account/Login"><i class="fa fa-arrow-left"></i> Quay lại đăng nhập</a>
        </div>
    </div>
</div>

@section Scripts {
<script>
function togglePass(inputId, iconId) {
    const inp = document.getElementById(inputId);
    const icon = document.getElementById(iconId);
    if (inp.type === 'password') {
        inp.type = 'text';
        icon.className = 'fa fa-eye-slash';
    } else {
        inp.type = 'password';
        icon.className = 'fa fa-eye';
    }
}

// Password strength
document.getElementById('newPassInput').addEventListener('input', function() {
    const val = this.value;
    const bar = document.getElementById('strengthBar');
    const txt = document.getElementById('strengthText');
    let score = 0;
    if (val.length >= 6) score++;
    if (val.length >= 10) score++;
    if (/[A-Z]/.test(val)) score++;
    if (/[0-9]/.test(val)) score++;
    if (/[^A-Za-z0-9]/.test(val)) score++;

    const levels = [
        { w: '0%', c: 'transparent', t: '' },
        { w: '25%', c: '#c62828', t: 'Yếu' },
        { w: '50%', c: '#ff9800', t: 'Trung bình' },
        { w: '75%', c: '#ffc107', t: 'Khá' },
        { w: '100%', c: '#ff4d00', t: 'Mạnh' },
        { w: '100%', c: '#0a7d3c', t: 'Rất mạnh' }
    ];
    const lvl = levels[Math.min(score, 5)];
    bar.style.width = lvl.w;
    bar.style.background = lvl.c;
    txt.textContent = lvl.t;
    txt.style.color = lvl.c;
    checkMatch();
});

// Confirm match
document.getElementById('confirmPassInput').addEventListener('input', checkMatch);

function checkMatch() {
    const p1 = document.getElementById('newPassInput').value;
    const p2 = document.getElementById('confirmPassInput').value;
    const msg = document.getElementById('matchMsg');
    if (!p2) { msg.textContent = ''; return; }
    if (p1 === p2) {
        msg.innerHTML = '<i class="fa fa-check-circle" style="color:#0a7d3c"></i> <span style="color:#0a7d3c">Mật khẩu khớp</span>';
    } else {
        msg.innerHTML = '<i class="fa fa-times-circle" style="color:#c62828"></i> <span style="color:#c62828">Mật khẩu không khớp</span>';
    }
}
</script>
}

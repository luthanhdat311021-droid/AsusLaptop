@model AsusLaptop.Models.Order
@{
    ViewData["Title"] = "Chi tiết đơn hàng #" + Model.Id;
}

<div class="account-wrap">
    <div class="account-layout">
        <div class="account-sidebar">
            <div class="account-sidebar-header">
                <h3>@User.FindFirst("FullName")?.Value</h3>
                <p>@User.Identity?.Name</p>
            </div>
            <a href="/Account/Profile" class="sidebar-link"><i class="fa fa-user"></i> Thông tin cá nhân</a>
            <a href="/Account/MyOrders" class="sidebar-link active"><i class="fa fa-box"></i> Đơn hàng của tôi</a>
            <a href="/Account/Addresses" class="sidebar-link"><i class="fa fa-map-marker-alt"></i> Sổ địa chỉ</a>
            <a href="/Return/MyReturns" class="sidebar-link"><i class="fa fa-undo-alt"></i> Trả hàng/Hoàn tiền</a>
                                    <a href="/Account/ChangePassword" class="sidebar-link"><i class="fa fa-lock"></i> Đổi mật khẩu</a>
            <a href="/Account/Logout" class="sidebar-link" style="color:var(--rog-red)"><i class="fa fa-sign-out-alt"></i> Đăng xuất</a>
        </div>

        <div>
            <div class="account-card">
                <div class="account-card-header">
                    <h2><i class="fa fa-file-invoice"></i> Đơn hàng #@Model.Id</h2>
                    <div style="display:flex;gap:8px">
                        @if (Model.Status == "Pending" && (Model.PaymentMethod == "VNPay" || Model.PaymentMethod == "Momo") && Model.PaymentStatus != "Paid")
                        {
                            <a asp-action="ContinuePayment" asp-controller="Cart" asp-route-orderId="@Model.Id"
                               class="btn-primary" style="font-size:13px;padding:7px 14px;background:var(--success,#2e9e4f);border-color:var(--success,#2e9e4f)">
                                <i class="fa fa-credit-card"></i> Tiếp tục thanh toán
                            </a>
                        }
                        @if (Model.Status == "Shipped" || Model.Status == "Processing")
                        {
                            <a href="/OrderTracking/Track/@Model.Id" class="btn-primary" style="font-size:13px;padding:7px 14px">
                                <i class="fa fa-map-marker-alt"></i> Theo dõi đơn hàng
                            </a>
                        }
                        @if (Model.Status == "Completed" && (DateTime.Now - Model.OrderDate).TotalDays <= 30)
                        {
                            <a href="/Return/Create/@Model.Id" class="btn-ghost" style="font-size:13px;padding:7px 14px;color:var(--rog-red,#e0393e)">
                                <i class="fa fa-undo-alt"></i> Trả hàng/Hoàn tiền
                            </a>
                        }
                        <a href="/Account/Invoice/@Model.Id" target="_blank" class="btn-ghost" style="font-size:13px;padding:7px 14px">
                            <i class="fa fa-print"></i> In hoá đơn
                        </a>
                        <a href="/Account/MyOrders" class="btn-ghost" style="font-size:13px;padding:7px 14px">
                            <i class="fa fa-arrow-left"></i> Quay lại
                        </a>
                    </div>
                </div>
                <div class="account-card-body">
                    @if (Model.Status == "Pending" && (Model.PaymentMethod == "VNPay" || Model.PaymentMethod == "Momo") && Model.PaymentStatus != "Paid")
                    {
                        <div style="padding:10px 16px;margin-bottom:20px;font-size:13px;color:var(--tuf-yellow,#e0a000);background:rgba(224,160,0,.08);border:1px solid rgba(224,160,0,.25);border-radius:var(--radius)">
                            <i class="fa fa-clock"></i> Đơn hàng sẽ <strong>tự động hủy</strong> nếu không hoàn tất thanh toán trong vòng <strong>15 phút</strong> kể từ lúc đặt hàng (@Model.OrderDate.ToString("HH:mm dd/MM")).
                        </div>
                    }
                    <!-- Status & Info -->
                    <div style="display:grid;grid-template-columns:1fr 1fr;gap:20px;margin-bottom:24px">
                        <div style="background:var(--bg-card2);border:1px solid var(--border);border-radius:var(--radius);padding:16px">
                            <div style="font-size:11px;color:var(--text-muted);text-transform:uppercase;letter-spacing:1px;margin-bottom:10px">Trạng thái</div>
                            <span class="order-status status-@Model.Status.ToLower()" style="font-size:13px">
                                @(Model.Status switch {
                                    "Pending" => "⏳ Chờ xử lý",
                                    "Processing" => "⚙️ Đang xử lý",
                                    "Shipped" => "🚚 Đang giao hàng",
                                    "Completed" => "✅ Hoàn thành",
                                    "Cancelled" => "❌ Đã hủy",
                                    "Refunded" => "💸 Đã hoàn tiền",
                                    _ => Model.Status
                                })
                            </span>
                        </div>
                        <div style="background:var(--bg-card2);border:1px solid var(--border);border-radius:var(--radius);padding:16px">
                            <div style="font-size:11px;color:var(--text-muted);text-transform:uppercase;letter-spacing:1px;margin-bottom:10px">Ngày đặt</div>
                            <span style="font-weight:600">@Model.OrderDate.ToString("dd/MM/yyyy HH:mm")</span>
                        </div>
                    </div>

                    @if (Model.PaymentMethod == "BankTransfer")
                    {
                        string psColor3 = Model.PaymentStatus == "Paid" ? "rgba(0,212,170,0.15)" : "rgba(255,200,0,0.08)";
                        string psBorder3 = Model.PaymentStatus == "Paid" ? "rgba(0,212,170,0.3)" : "rgba(255,200,0,0.25)";
                        <div style="background:@psColor3;border:1px solid @psBorder3;border-radius:var(--radius);padding:16px;margin-bottom:24px">
                            <div style="font-size:12px;font-weight:700;margin-bottom:12px;text-transform:uppercase;letter-spacing:1px;color:var(--text-secondary)">
                                <i class="fa fa-qrcode"></i> Thanh toán chuyển khoản
                            </div>
                            @if (Model.PaymentStatus == "Paid")
                            {
                                <div style="text-align:center;font-size:14px;font-weight:700;color:var(--success);padding:8px">
                                    <i class="fa fa-check-double"></i> Đã thanh toán thành công
                                </div>
                            }
                            else
                            {
                                <div style="display:flex;gap:16px;align-items:flex-start;flex-wrap:wrap">
                                    <div style="background:white;border-radius:10px;padding:10px;flex-shrink:0">
                                        <img src="https://img.vietqr.io/image/MB-0819883208-compact2.jpg?amount=@((long)Model.TotalAmount)&addInfo=ASUS%20don%20hang%20@(Model.Id)&accountName=ASUS%20LAPTOP%20STORE"
                                             alt="QR Code" style="width:150px;height:150px;display:block" />
                                    </div>
                                    <div style="font-size:12px;line-height:2;color:var(--text-secondary)">
                                        <div><span style="color:var(--text-muted);width:100px;display:inline-block">Ngân hàng:</span> <strong>MB Bank</strong></div>
                                        <div><span style="color:var(--text-muted);width:100px;display:inline-block">Số tài khoản:</span> <strong style="color:var(--accent)">0819883208</strong></div>
                                        <div><span style="color:var(--text-muted);width:100px;display:inline-block">Chủ TK:</span> <strong>ASUS LAPTOP STORE</strong></div>
                                        <div><span style="color:var(--text-muted);width:100px;display:inline-block">Số tiền:</span> <strong style="color:var(--rog-red);font-size:15px">@Model.TotalAmount.ToString("N0")₫</strong></div>
                                        <div><span style="color:var(--text-muted);width:100px;display:inline-block">Nội dung CK:</span> <strong style="color:var(--tuf-yellow)">ASUS don hang @Model.Id</strong></div>
                                    </div>
                                </div>
                            }
                        </div>
                    }

                    <!-- Shipping info -->
                    <div style="background:var(--bg-card2);border:1px solid var(--border);border-radius:var(--radius);padding:16px;margin-bottom:20px">
                        <div style="font-size:12px;font-weight:700;color:var(--text-muted);text-transform:uppercase;letter-spacing:1px;margin-bottom:12px">
                            <i class="fa fa-truck" style="color:var(--accent)"></i> Thông tin giao hàng
                        </div>
                        <div style="display:grid;grid-template-columns:1fr 1fr;gap:10px;font-size:13px">
                            <div><span style="color:var(--text-muted)">Người nhận:</span> <strong>@Model.CustomerName</strong></div>
                            <div><span style="color:var(--text-muted)">SĐT:</span> <strong>@Model.Phone</strong></div>
                            <div style="grid-column:1/-1"><span style="color:var(--text-muted)">Địa chỉ:</span> <strong>@Model.Address</strong></div>
                            @if (!string.IsNullOrEmpty(Model.Email))
                            {
                                <div><span style="color:var(--text-muted)">Email:</span> <strong>@Model.Email</strong></div>
                            }
                            @if (!string.IsNullOrEmpty(Model.Note))
                            {
                                <div style="grid-column:1/-1"><span style="color:var(--text-muted)">Ghi chú:</span> <strong>@Model.Note</strong></div>
                            }
                        </div>
                    </div>

                    <!-- Products -->
                    <div style="background:var(--bg-card2);border:1px solid var(--border);border-radius:var(--radius);overflow:hidden;margin-bottom:16px">
                        <div style="padding:14px 16px;border-bottom:1px solid var(--border);font-size:12px;font-weight:700;color:var(--text-muted);text-transform:uppercase;letter-spacing:1px">
                            <i class="fa fa-laptop" style="color:var(--accent)"></i> Sản phẩm (@Model.OrderDetails.Count)
                        </div>
                        @foreach (var detail in Model.OrderDetails)
                        {
                            <div style="display:grid;grid-template-columns:60px 1fr auto;gap:12px;align-items:center;padding:14px 16px;border-bottom:1px solid var(--border)">
                                <div style="background:var(--bg-card);border-radius:var(--radius);padding:6px;display:flex;align-items:center;justify-content:center">
                                    @if (!string.IsNullOrEmpty(detail.Product?.ImageUrl))
                                    {
                                        <img src="@detail.Product.ImageUrl" alt="" style="max-height:44px;object-fit:contain" onerror="this.style.display='none'" />
                                    }
                                    else
                                    {
                                        <i class="fa fa-laptop" style="color:var(--text-muted);font-size:20px"></i>
                                    }
                                </div>
                                <div>
                                    <div style="font-size:10px;color:var(--accent);font-weight:700;text-transform:uppercase;letter-spacing:1px">@detail.Product?.Series</div>
                                    <div style="font-size:13px;font-weight:600">@detail.Product?.Name</div>
                                    <div style="font-size:12px;color:var(--text-muted)">Đơn giá: @detail.Price.ToString("N0")₫</div>
                                    @{
                                        var detailSerials = (ViewBag.SerialsByDetail as Dictionary<int, List<string>>)?.GetValueOrDefault(detail.Id);
                                    }
                                    @if (detailSerials != null && detailSerials.Any())
                                    {
                                        <div style="font-size:12px;color:var(--success);margin-top:4px">
                                            <i class="fa fa-barcode"></i> Serial: <strong>@string.Join(", ", detailSerials)</strong>
                                        </div>
                                    }
                                </div>
                                <div style="text-align:right">
                                    <div style="font-size:12px;color:var(--text-muted)">x@(detail.Quantity)</div>
                                    <div style="font-family:'Barlow Condensed',sans-serif;font-size:18px;font-weight:700;color:var(--rog-red)">
                                        @((detail.Price * detail.Quantity).ToString("N0"))₫
                                    </div>
                                </div>
                            </div>
                        }
                        <div style="display:flex;justify-content:flex-end;padding:16px;gap:8px;align-items:center">
                            <span style="font-size:13px;color:var(--text-muted)">Tổng cộng:</span>
                            <span style="font-family:'Barlow Condensed',sans-serif;font-size:26px;font-weight:800;color:var(--rog-red)">
                                @Model.TotalAmount.ToString("N0")₫
                            </span>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

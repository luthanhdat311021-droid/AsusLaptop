@{
    ViewData["Title"] = "Đổi mật khẩu";
}

<div class="account-wrap">
    <div class="account-layout">
        <div class="account-sidebar">
            <div class="account-sidebar-header">
                <h3>@User.FindFirst("FullName")?.Value</h3>
                <p>@User.Identity?.Name</p>
            </div>
            <a href="/Account/Profile" class="sidebar-link"><i class="fa fa-user"></i> Thông tin cá nhân</a>
            <a href="/Account/MyOrders" class="sidebar-link"><i class="fa fa-box"></i> Đơn hàng của tôi</a>
            <a href="/Account/Addresses" class="sidebar-link"><i class="fa fa-map-marker-alt"></i> Sổ địa chỉ</a>
            <a href="/Return/MyReturns" class="sidebar-link"><i class="fa fa-undo-alt"></i> Trả hàng/Hoàn tiền</a>
                                    <a href="/Account/ChangePassword" class="sidebar-link active"><i class="fa fa-lock"></i> Đổi mật khẩu</a>
            <a href="/Account/Logout" class="sidebar-link" style="color:var(--rog-red)"><i class="fa fa-sign-out-alt"></i> Đăng xuất</a>
        </div>

        <div>
            <div class="account-card">
                <div class="account-card-header">
                    <h2><i class="fa fa-lock"></i> Đổi mật khẩu</h2>
                </div>
                <div class="account-card-body" style="max-width:480px">
                    @if (!ViewData.ModelState.IsValid)
                    {
                        <div class="alert alert-danger mb-2">
                            <i class="fa fa-exclamation-circle"></i>
                            <div>
                                @foreach (var error in ViewData.ModelState.Values.SelectMany(v => v.Errors))
                                {
                                    <div>@error.ErrorMessage</div>
                                }
                            </div>
                        </div>
                    }

                    <form asp-action="ChangePassword" method="post">
                        @Html.AntiForgeryToken()

                        <div class="form-group" style="margin-bottom:14px">
                            <label class="form-label">Mật khẩu hiện tại *</label>
                            <input type="password" name="currentPassword" class="form-control" placeholder="••••••••" required />
                        </div>
                        <div class="form-group" style="margin-bottom:14px">
                            <label class="form-label">Mật khẩu mới *</label>
                            <input type="password" name="newPassword" id="newPw" class="form-control" placeholder="Ít nhất 6 ký tự" required minlength="6" />
                            <div id="pwTips" style="margin-top:8px;display:flex;flex-wrap:wrap;gap:6px">
                                <span class="spec-tag" id="tip-len">✗ 6+ ký tự</span>
                                <span class="spec-tag" id="tip-upper">✗ Chữ hoa</span>
                                <span class="spec-tag" id="tip-num">✗ Số</span>
                                <span class="spec-tag" id="tip-special">✗ Ký tự đặc biệt</span>
                            </div>
                        </div>
                        <div class="form-group" style="margin-bottom:20px">
                            <label class="form-label">Xác nhận mật khẩu mới *</label>
                            <input type="password" name="confirmNewPassword" class="form-control" placeholder="••••••••" required />
                        </div>

                        <button type="submit" class="btn-primary"><i class="fa fa-save"></i> Cập nhật mật khẩu</button>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
<script>
document.getElementById('newPw')?.addEventListener('input', function() {
    const pw = this.value;
    const update = (id, cond) => {
        const el = document.getElementById(id);
        if (!el) return;
        el.textContent = (cond ? '✓ ' : '✗ ') + el.textContent.slice(2);
        el.style.color = cond ? 'var(--success)' : '';
        el.style.borderColor = cond ? 'var(--success)' : '';
    };
    update('tip-len', pw.length >= 6);
    update('tip-upper', /[A-Z]/.test(pw));
    update('tip-num', /[0-9]/.test(pw));
    update('tip-special', /[!@@#$%^&*]/.test(pw));
});
</script>
}

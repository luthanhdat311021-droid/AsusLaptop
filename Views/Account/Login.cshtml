@{
    ViewData["Title"] = "Đăng nhập";
    Layout = "_Layout";
}

<div class="auth-wrap">
    <div class="auth-card">
        <div class="auth-header">
            <div class="auth-logo">
                <span class="logo-asus" style="font-size:32px">ASUS</span>
            </div>
            <h2 class="auth-title">Đăng nhập</h2>
            <p class="auth-subtitle">Chào mừng trở lại! Vui lòng đăng nhập.</p>
        </div>

        @if (!ViewData.ModelState.IsValid)
        {
            <div class="alert alert-danger">
                <i class="fa fa-exclamation-circle"></i>
                <div>
                    @foreach (var error in ViewData.ModelState.Values.SelectMany(v => v.Errors))
                    {
                        <div>@error.ErrorMessage</div>
                    }
                </div>
            </div>
        }

        @if (TempData["SuccessMessage"] != null)
        {
            <div class="alert alert-success"><i class="fa fa-check-circle"></i> @TempData["SuccessMessage"]</div>
        }
        @if (TempData["ErrorMessage"] != null)
        {
            <div class="alert alert-danger"><i class="fa fa-times-circle"></i> @TempData["ErrorMessage"]</div>
        }

        <form asp-action="Login" method="post">
            @Html.AntiForgeryToken()
            <input type="hidden" name="returnUrl" value="@ViewData["ReturnUrl"]" />

            <div class="form-group" style="margin-bottom:14px">
                <label class="form-label">Tên đăng nhập</label>
                <div class="input-icon-wrap">
                    <i class="fa fa-user fi"></i>
                    <input type="text" name="username" class="form-control" placeholder="username" required autofocus />
                </div>
            </div>

            <div class="form-group" style="margin-bottom:20px">
                <label class="form-label">Mật khẩu</label>
                <div class="input-icon-wrap">
                    <i class="fa fa-lock fi"></i>
                    <input type="password" name="password" id="passInput" class="form-control" placeholder="••••••••" required />
                    <button type="button" onclick="togglePass()" style="position:absolute;right:12px;top:50%;transform:translateY(-50%);color:var(--text-muted);font-size:14px" id="eyeBtn">
                        <i class="fa fa-eye" id="eyeIcon"></i>
                    </button>
                </div>
                <div style="text-align:right;margin-top:6px">
                    <a href="/Account/ForgotPassword" style="font-size:12px;color:var(--accent);text-decoration:none">
                        <i class="fa fa-key"></i> Quên mật khẩu?
                    </a>
                </div>
            </div>

            <button type="submit" class="btn-submit">
                <i class="fa fa-sign-in-alt"></i> Đăng nhập
            </button>
        </form>

        <!-- Divider -->
        <div style="display:flex;align-items:center;gap:10px;margin:18px 0">
            <div style="flex:1;height:1px;background:var(--border)"></div>
            <span style="font-size:12px;color:var(--text-muted)">hoặc</span>
            <div style="flex:1;height:1px;background:var(--border)"></div>
        </div>

        <!-- Google Login Button -->
        <a href="/Account/LoginWithGoogle?returnUrl=@ViewData["ReturnUrl"]"
           style="display:flex;align-items:center;justify-content:center;gap:10px;
                  width:100%;padding:11px;border-radius:var(--radius);
                  border:1px solid var(--border);background:var(--bg-card2);
                  color:var(--text-primary);font-size:14px;font-weight:500;
                  text-decoration:none;transition:all .2s"
           onmouseover="this.style.background='var(--bg-card)'"
           onmouseout="this.style.background='var(--bg-card2)'">
            <svg width="18" height="18" viewBox="0 0 48 48">
                <path fill="#EA4335" d="M24 9.5c3.54 0 6.71 1.22 9.21 3.6l6.85-6.85C35.9 2.38 30.47 0 24 0 14.62 0 6.51 5.38 2.56 13.22l7.98 6.19C12.43 13.72 17.74 9.5 24 9.5z"/>
                <path fill="#4285F4" d="M46.98 24.55c0-1.57-.15-3.09-.38-4.55H24v9.02h12.94c-.58 2.96-2.26 5.48-4.78 7.18l7.73 6c4.51-4.18 7.09-10.36 7.09-17.65z"/>
                <path fill="#FBBC05" d="M10.53 28.59c-.48-1.45-.76-2.99-.76-4.59s.27-3.14.76-4.59l-7.98-6.19C.92 16.46 0 20.12 0 24c0 3.88.92 7.54 2.56 10.78l7.97-6.19z"/>
                <path fill="#34A853" d="M24 48c6.48 0 11.93-2.13 15.89-5.81l-7.73-6c-2.18 1.48-4.97 2.31-8.16 2.31-6.26 0-11.57-4.22-13.47-9.91l-7.98 6.19C6.51 42.62 14.62 48 24 48z"/>
            </svg>
            Đăng nhập với Google
        </a>


        <!-- Facebook Login Button -->
        <a href="/Account/LoginWithFacebook?returnUrl=@ViewData["ReturnUrl"]"
           style="display:flex;align-items:center;justify-content:center;gap:10px;
                  width:100%;padding:11px;border-radius:var(--radius);margin-top:10px;
                  border:1px solid rgba(24,119,242,0.4);background:rgba(24,119,242,0.08);
                  color:#4a90e2;font-size:14px;font-weight:500;
                  text-decoration:none;transition:all .2s"
           onmouseover="this.style.background='rgba(24,119,242,0.18)'"
           onmouseout="this.style.background='rgba(24,119,242,0.08)'">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="#1877F2">
                <path d="M24 12.073C24 5.405 18.627 0 12 0S0 5.405 0 12.073C0 18.1 4.388 23.094 10.125 24v-8.437H7.078v-3.49h3.047V9.41c0-3.025 1.792-4.697 4.533-4.697 1.313 0 2.686.236 2.686.236v2.97h-1.513c-1.491 0-1.956.93-1.956 1.874v2.25h3.328l-.532 3.49h-2.796V24C19.612 23.094 24 18.1 24 12.073z"/>
            </svg>
            Đăng nhập với Facebook
        </a>

        <!-- Face ID Login Button -->
        <button type="button" onclick="openFaceLogin()"
           style="display:flex;align-items:center;justify-content:center;gap:10px;
                  width:100%;padding:11px;border-radius:var(--radius);margin-top:10px;
                  border:1px solid rgba(255,77,0,0.4);background:rgba(255,77,0,0.07);
                  color:#ff4d00;font-size:14px;font-weight:600;cursor:pointer;
                  transition:all .2s"
           onmouseover="this.style.background='rgba(255,77,0,0.15)'"
           onmouseout="this.style.background='rgba(255,77,0,0.07)'">
            <i class="fa fa-camera" style="font-size:16px"></i>
            Đăng nhập bằng Face ID
        </button>

        <div class="auth-footer" style="margin-top:16px">
            Chưa có tài khoản? <a href="/Account/Register">Đăng ký ngay</a>
        </div>

        <div style="margin-top:20px;padding:14px;background:var(--bg-card2);border-radius:var(--radius);font-size:12px;color:var(--text-muted)">
            <div style="margin-bottom:4px"><i class="fa fa-info-circle" style="color:var(--accent)"></i> Tài khoản demo:</div>
            <div>Admin: <strong style="color:var(--text-primary)">admin / admin123</strong></div>
            <div>KH: <strong style="color:var(--text-primary)">customer / customer123</strong></div>
        </div>
    </div>
</div>

<!-- Face ID Modal -->
<div id="faceModal" style="display:none;position:fixed;inset:0;background:rgba(0,0,0,0.85);z-index:9999;align-items:center;justify-content:center">
    <div style="background:var(--bg-card);border:1px solid rgba(255,77,0,0.3);border-radius:16px;padding:28px;width:360px;text-align:center;box-shadow:0 0 40px rgba(255,77,0,0.1)">
        <h3 style="color:#ff4d00;margin-bottom:6px"><i class="fa fa-camera"></i> Face ID</h3>
        <p id="faceStatus" style="font-size:13px;color:var(--text-muted);margin-bottom:16px">Nhìn thẳng vào camera...</p>

        <div style="position:relative;display:inline-block">
            <video id="faceVideo" autoplay playsinline style="width:280px;height:210px;border-radius:12px;object-fit:cover;border:2px solid rgba(255,77,0,0.3)"></video>
            <!-- Overlay khung nhận diện -->
            <div style="position:absolute;inset:0;pointer-events:none">
                <div style="position:absolute;top:20px;left:20px;width:40px;height:40px;border-top:3px solid #ff4d00;border-left:3px solid #ff4d00;border-radius:4px 0 0 0"></div>
                <div style="position:absolute;top:20px;right:20px;width:40px;height:40px;border-top:3px solid #ff4d00;border-right:3px solid #ff4d00;border-radius:0 4px 0 0"></div>
                <div style="position:absolute;bottom:20px;left:20px;width:40px;height:40px;border-bottom:3px solid #ff4d00;border-left:3px solid #ff4d00;border-radius:0 0 0 4px"></div>
                <div style="position:absolute;bottom:20px;right:20px;width:40px;height:40px;border-bottom:3px solid #ff4d00;border-right:3px solid #ff4d00;border-radius:0 0 4px 0"></div>
            </div>
        </div>

        <canvas id="faceCanvas" style="display:none"></canvas>

        <div style="display:flex;gap:10px;margin-top:16px">
            <button id="faceScanBtn" onclick="scanFace()"
                style="flex:1;padding:10px;border-radius:8px;background:#ff4d00;color:#fff;font-weight:700;border:none;cursor:pointer;font-size:14px">
                <i class="fa fa-search"></i> Quét khuôn mặt
            </button>
            <button onclick="closeFaceModal()"
                style="padding:10px 16px;border-radius:8px;background:var(--bg-card2);color:var(--text-muted);border:1px solid var(--border);cursor:pointer">
                Hủy
            </button>
        </div>

        <div id="faceResult" style="display:none;margin-top:14px;padding:10px;border-radius:8px;font-size:13px;font-weight:600"></div>
    </div>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/face-api.js@0.22.2/dist/face-api.min.js"></script>
<script>
        const MODEL_URL = 'https://justadudewhohacks.github.io/face-api.js/models';
let faceStream = null;
let faceModelsLoaded = false;

// Preload models khi trang load
(async () => {
    try {
        await Promise.all([
            faceapi.nets.tinyFaceDetector.loadFromUri(MODEL_URL),
            faceapi.nets.faceLandmark68TinyNet.loadFromUri(MODEL_URL),
            faceapi.nets.faceRecognitionNet.loadFromUri(MODEL_URL)
        ]);
        faceModelsLoaded = true;
    } catch(e) { console.log('face-api load error:', e); }
})();

async function openFaceLogin() {
    document.getElementById('faceModal').style.display = 'flex';
    const status = document.getElementById('faceStatus');

    if (!faceModelsLoaded) {
        status.textContent = 'Đang tải AI nhận diện... vui lòng chờ';
        try {
            await Promise.all([
                faceapi.nets.tinyFaceDetector.loadFromUri(MODEL_URL),
                faceapi.nets.faceLandmark68TinyNet.loadFromUri(MODEL_URL),
                faceapi.nets.faceRecognitionNet.loadFromUri(MODEL_URL)
            ]);
            faceModelsLoaded = true;
        } catch(e) {
            status.textContent = 'Không tải được AI. Kiểm tra kết nối mạng.';
            return;
        }
    }

    status.textContent = 'Đang khởi động camera...';
    document.getElementById('faceResult').style.display = 'none';
    try {
        faceStream = await navigator.mediaDevices.getUserMedia({ video: { width: 280, height: 210, facingMode: 'user' } });
        document.getElementById('faceVideo').srcObject = faceStream;
        status.textContent = 'Nhìn thẳng vào camera rồi nhấn Quét khuôn mặt';
    } catch(e) {
        status.textContent = 'Không thể truy cập camera: ' + e.message;
    }
}

function closeFaceModal() {
    if (faceStream) { faceStream.getTracks().forEach(t => t.stop()); faceStream = null; }
    document.getElementById('faceModal').style.display = 'none';
}

async function scanFace() {
    const btn = document.getElementById('faceScanBtn');
    const status = document.getElementById('faceStatus');
    const result = document.getElementById('faceResult');

    btn.disabled = true;
    btn.innerHTML = '<i class="fa fa-spinner fa-spin"></i> Đang nhận diện...';
    status.textContent = 'Đang phân tích khuôn mặt...';

    const video = document.getElementById('faceVideo');

    try {
        const detection = await faceapi
            .detectSingleFace(video, new faceapi.TinyFaceDetectorOptions())
            .withFaceLandmarks(true)
            .withFaceDescriptor();

        if (!detection) {
            result.style.display = 'block';
            result.style.background = 'rgba(230,0,42,0.1)';
            result.style.color = '#c62828';
            result.style.border = '1px solid rgba(230,0,42,0.3)';
            result.innerHTML = '<i class="fa fa-times-circle"></i> Không phát hiện khuôn mặt. Nhìn thẳng vào camera.';
            btn.disabled = false;
            btn.innerHTML = '<i class="fa fa-redo"></i> Thử lại';
            status.textContent = 'Nhìn thẳng vào camera và thử lại';
            return;
        }

        const descriptor = Array.from(detection.descriptor);

        const resp = await fetch('/Face/LoginWithFace', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ descriptor })
        });
        const data = await resp.json();

        result.style.display = 'block';
        if (data.success) {
            result.style.background = 'rgba(255,77,0,0.1)';
            result.style.color = '#ff4d00';
            result.style.border = '1px solid rgba(255,77,0,0.3)';
            result.innerHTML = '<i class="fa fa-check-circle"></i> ' + data.message;
            status.textContent = 'Đang chuyển hướng...';
            setTimeout(() => { closeFaceModal(); window.location.href = data.redirect; }, 1200);
        } else {
            result.style.background = 'rgba(230,0,42,0.1)';
            result.style.color = '#c62828';
            result.style.border = '1px solid rgba(230,0,42,0.3)';
            result.innerHTML = '<i class="fa fa-times-circle"></i> ' + data.message;
            btn.disabled = false;
            btn.innerHTML = '<i class="fa fa-redo"></i> Thử lại';
            status.textContent = 'Nhìn thẳng vào camera rồi thử lại';
        }
    } catch(e) {
        result.style.display = 'block';
        result.style.style = 'rgba(230,0,42,0.1)';
        result.style.color = '#c62828';
        result.innerHTML = '<i class="fa fa-times-circle"></i> Lỗi: ' + e.message;
        btn.disabled = false;
        btn.innerHTML = '<i class="fa fa-redo"></i> Thử lại';
    }
}

function togglePass() {
    const inp = document.getElementById('passInput');
    const icon = document.getElementById('eyeIcon');
    if (inp.type === 'password') {
        inp.type = 'text';
        icon.className = 'fa fa-eye-slash';
    } else {
        inp.type = 'password';
        icon.className = 'fa fa-eye';
    }
}
</script>
}

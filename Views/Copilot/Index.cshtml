@{ ViewData["Title"] = "Laptop Copilot"; }
<style>
.copilot-page{max-width:1100px;margin:42px auto;padding:0 20px;font-family:Barlow,sans-serif}.copilot-hero{padding:36px;border-radius:22px;color:#fff;background:linear-gradient(135deg,#121212,#532000 58%,#ff4d00);box-shadow:0 16px 42px rgba(255,77,0,.22)}.copilot-kicker{font-size:12px;letter-spacing:1px;font-weight:800;color:#ffbe9d}.copilot-hero h1{font-size:35px;margin:8px 0}.copilot-hero p{max-width:680px;margin:0;color:#ffece4}.copilot-box{display:flex;gap:10px;margin-top:24px;padding:8px;background:#fff;border-radius:13px}.copilot-box input{flex:1;border:0;outline:0;padding:13px;font:inherit;color:#222}.copilot-box button{border:0;border-radius:9px;background:#ff4d00;color:#fff;font-weight:700;padding:0 18px;cursor:pointer}.copilot-box .voice-button{background:#222;width:48px;padding:0;font-size:17px}.copilot-box .voice-button.listening{background:#c52a00;box-shadow:0 0 0 5px rgba(255,255,255,.22)}.voice-status{display:block;min-height:18px;margin-top:8px;color:#ffe2d4;font-size:12px}.copilot-examples{display:flex;gap:8px;flex-wrap:wrap;margin-top:10px}.copilot-examples button{background:rgba(255,255,255,.12);border:1px solid rgba(255,255,255,.25);border-radius:20px;color:#fff;padding:7px 11px;cursor:pointer;font:inherit;font-size:12px}#copilotResult{margin-top:28px}.copilot-loading{text-align:center;color:#777;padding:30px}.copilot-summary{margin:0 0 12px;color:#444}.need-chip{display:inline-block;margin:0 6px 18px 0;padding:6px 10px;border-radius:20px;background:#fff0e9;color:#d64200;font-size:12px;font-weight:700}.copilot-result-head{display:flex;justify-content:space-between;gap:12px;align-items:start}.speak-result{border:1px solid #ff4d00;border-radius:8px;background:#fff;color:#d64200;padding:8px 11px;cursor:pointer;white-space:nowrap;font:inherit;font-size:12px;font-weight:700}.copilot-cards{display:grid;grid-template-columns:repeat(3,1fr);gap:16px}.copilot-card{overflow:hidden;border:1px solid #eee;border-radius:15px;background:#fff;box-shadow:0 6px 18px rgba(0,0,0,.06)}.copilot-card img{width:100%;height:145px;object-fit:cover;background:#f4f4f4}.copilot-card-body{padding:15px}.copilot-top{display:flex;justify-content:space-between;gap:8px}.copilot-top h3{font-size:16px;margin:0;color:#1b1b1b}.copilot-match{color:#e64500;font-size:14px;font-weight:800;white-space:nowrap}.copilot-series,.copilot-specs{color:#777;font-size:12px;margin:5px 0}.copilot-price{display:block;color:#e64500;font-size:18px;font-weight:800;margin:12px 0}.copilot-strength{padding:8px;border-radius:8px;background:#f7fbf8;color:#257341;font-size:12px;margin:6px 0}.copilot-tradeoff{font-size:12px;color:#795024;margin:10px 0}.copilot-card a{display:block;text-align:center;padding:9px;border-radius:8px;background:#161616;color:#fff;text-decoration:none;font-size:13px;font-weight:700}@@media(max-width:760px){.copilot-page{margin:20px auto}.copilot-hero{padding:24px}.copilot-hero h1{font-size:28px}.copilot-cards{grid-template-columns:1fr}.copilot-box{flex-wrap:wrap}.copilot-box input{width:100%}.copilot-box button:not(.voice-button){flex:1;padding:12px}.copilot-result-head{display:block}.speak-result{margin-bottom:12px}}
</style>
<div class="copilot-page"><section class="copilot-hero"><div class="copilot-kicker"><i class="fa fa-wand-magic-sparkles"></i> ASUS AI SHOPPING ASSISTANT</div><h1>Laptop Copilot</h1><p>Nói hoặc nhập nhu cầu của bạn. Copilot sẽ chọn máy phù hợp, giải thích cấu hình và nêu rõ điểm đánh đổi.</p><div class="copilot-box"><input id="copilotInput" maxlength="500" placeholder="Ví dụ: Tôi học thiết kế, ngân sách 25 triệu, cần máy nhẹ và màn đẹp" /><button id="copilotVoice" class="voice-button" type="button" title="Nói nhu cầu"><i class="fa fa-microphone"></i></button><button id="copilotSend" type="button"><i class="fa fa-sparkles"></i> Tư vấn ngay</button></div><span id="voiceStatus" class="voice-status">Nhấn micro và nói bằng tiếng Việt.</span><div class="copilot-examples"><button data-example="Tôi chơi game và làm đồ họa, ngân sách 35 triệu">Gaming & đồ họa 35 triệu</button><button data-example="Tôi là sinh viên cần máy nhẹ để học và lập trình, khoảng 20 triệu">Học & lập trình 20 triệu</button><button data-example="Tôi cần laptop văn phòng màn hình đẹp, ngân sách 25 triệu">Văn phòng màn đẹp 25 triệu</button></div></section><section id="copilotResult" aria-live="polite"></section></div>
@section Scripts { <script>
(() => {const input=document.getElementById('copilotInput'),send=document.getElementById('copilotSend'),voiceButton=document.getElementById('copilotVoice'),voiceStatus=document.getElementById('voiceStatus'),result=document.getElementById('copilotResult');let voiceAnswer='',vietnameseVoices=[];const esc=s=>String(s||'').replace(/[&<>'"]/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;',"'":'&#039;','"':'&quot;'}[c]));function loadVietnameseVoices(){vietnameseVoices=(speechSynthesis.getVoices()||[]).filter(v=>/^vi(-|$)/i.test(v.lang));}if('speechSynthesis'in window){loadVietnameseVoices();speechSynthesis.onvoiceschanged=loadVietnameseVoices;}const speak=text=>{if(!('speechSynthesis'in window)){alert('Trình duyệt chưa hỗ trợ đọc thành tiếng.');return;}loadVietnameseVoices();const voice=vietnameseVoices.find(v=>v.lang.toLowerCase()==='vi-vn')||vietnameseVoices[0];if(!voice){alert('Thiết bị chưa cài giọng đọc tiếng Việt. Hãy thêm Vietnamese voice trong cài đặt hệ điều hành hoặc dùng Microsoft Edge. Copilot sẽ không đọc bằng tiếng Anh.');return;}speechSynthesis.cancel();const u=new SpeechSynthesisUtterance(text);u.lang=voice.lang;u.voice=voice;u.rate=.98;speechSynthesis.speak(u);};async function recommend(){const message=input.value.trim();if(!message){input.focus();return;}send.disabled=true;result.innerHTML='<div class="copilot-loading"><i class="fa fa-spinner fa-spin"></i> Copilot đang đối chiếu cấu hình...</div>';try{const res=await fetch('/Copilot/Recommend',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({message})}),data=await res.json();if(!res.ok)throw Error(data.message||'Không thể tư vấn lúc này.');const needs=(data.detectedNeeds||[]).map(x=>'<span class="need-chip">'+esc(x)+'</span>').join('');voiceAnswer=data.summary+' '+(data.recommendations||[]).map(p=>p.name+'. '+(p.strengths||[]).join('. ')+'. '+p.tradeoff).join(' ');const cards=(data.recommendations||[]).map(p=>'<article class="copilot-card"><img src="'+esc(p.imageUrl||'https://images.unsplash.com/photo-1496181133206-80ce9b88a853?auto=format&fit=crop&w=600&q=80')+'" alt="'+esc(p.name)+'"><div class="copilot-card-body"><div class="copilot-top"><h3>'+esc(p.name)+'</h3><span class="copilot-match">'+p.matchPercent+'%</span></div><div class="copilot-series">'+esc(p.series)+'</div><div class="copilot-specs">'+esc(p.specs)+'</div><span class="copilot-price">'+esc(p.price)+'</span>'+(p.strengths||[]).map(s=>'<div class="copilot-strength"><i class="fa fa-check"></i> '+esc(s)+'</div>').join('')+'<p class="copilot-tradeoff"><i class="fa fa-scale-balanced"></i> '+esc(p.tradeoff)+'</p><a href="/Product/Details/'+p.id+'">Xem chi tiết</a></div></article>').join('');result.innerHTML='<div class="copilot-result-head"><p class="copilot-summary"><strong>Copilot:</strong> '+esc(data.summary)+'</p><button id="speakResult" class="speak-result"><i class="fa fa-volume-high"></i> Nghe tư vấn tiếng Việt</button></div>'+needs+'<div class="copilot-cards">'+cards+'</div>';document.getElementById('speakResult').onclick=()=>speak(voiceAnswer);}catch(e){result.innerHTML='<div class="copilot-loading">'+esc(e.message)+'</div>';}finally{send.disabled=false;}}
const Recognition=window.SpeechRecognition||window.webkitSpeechRecognition;if(Recognition){const recognition=new Recognition();recognition.lang='vi-VN';recognition.interimResults=true;recognition.continuous=false;recognition.onstart=()=>{voiceButton.classList.add('listening');voiceButton.innerHTML='<i class="fa fa-stop"></i>';voiceStatus.textContent='Đang nghe... hãy nói nhu cầu của bạn.'};recognition.onresult=e=>{let text='';for(let i=e.resultIndex;i<e.results.length;i++)text+=e.results[i][0].transcript;input.value=text;if(e.results[e.results.length-1].isFinal){voiceStatus.textContent='Đã nhận giọng nói. Đang tư vấn...';recommend();}};recognition.onerror=e=>{voiceStatus.textContent=e.error==='not-allowed'?'Hãy cho phép trình duyệt dùng micro.':'Không nhận được giọng nói, vui lòng thử lại.'};recognition.onend=()=>{voiceButton.classList.remove('listening');voiceButton.innerHTML='<i class="fa fa-microphone"></i>'};voiceButton.onclick=()=>voiceButton.classList.contains('listening')?recognition.stop():recognition.start();}else{voiceButton.disabled=true;voiceStatus.textContent='Trình duyệt này chưa hỗ trợ nhận giọng nói. Hãy dùng Chrome hoặc Edge mới nhất.'}send.onclick=recommend;input.onkeydown=e=>{if(e.key==='Enter')recommend()};document.querySelectorAll('[data-example]').forEach(b=>b.onclick=()=>{input.value=b.dataset.example;recommend()});})();
</script><script src="~/js/copilot-cloud-voice.js"></script> }

            <div class="footer-col">
                <h4>Dòng Sản Phẩm High-End</h4>
                <a href="/?series=ROG+Strix"><i class="fa fa-angle-right"></i> ROG Strix Gaming</a>
                <a href="/?series=ROG+Zephyrus"><i class="fa fa-angle-right"></i> ROG Zephyrus Ultra Slim</a>
                <a href="/?series=ROG+Flow"><i class="fa fa-angle-right"></i> ROG Flow Convertible</a>
                <a href="/?series=TUF+Gaming"><i class="fa fa-angle-right"></i> TUF Gaming Durable</a>

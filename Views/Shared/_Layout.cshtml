    <!-- 3D LANDING PAGE INTERACTIVE TILT ENGINE -->
    <script>
    (function () {
        function init3DTilt() {
            var tiltElements = document.querySelectorAll('.tilt-3d, .nk-card, .product-card, .series-card, .feature-card, .hero-slide-card');
            tiltElements.forEach(function (el) {
                if (el.dataset.tiltInitialized) return;
                el.dataset.tiltInitialized = 'true';
                el.classList.add('tilt-3d');

                el.addEventListener('mousemove', function (e) {
                    var rect = el.getBoundingClientRect();
                    var x = e.clientX - rect.left;
                    var y = e.clientY - rect.top;
                    var centerX = rect.width / 2;
                    var centerY = rect.height / 2;

                    var rotateX = ((y - centerY) / centerY) * -12;
                    var rotateY = ((x - centerX) / centerX) * 12;

                    el.style.transform = 'perspective(1000px) rotateX(' + rotateX.toFixed(2) + 'deg) rotateY(' + rotateY.toFixed(2) + 'deg) translateZ(15px)';
                    el.style.setProperty('--mouse-x', (x / rect.width * 100).toFixed(1) + '%');
                    el.style.setProperty('--mouse-y', (y / rect.height * 100).toFixed(1) + '%');
                });

                el.addEventListener('mouseleave', function () {
                    el.style.transform = 'perspective(1000px) rotateX(0deg) rotateY(0deg) translateZ(0px)';
                });
            });
        }

        function initNavbarScroll() {
            var nav = document.querySelector('.luxury-navbar');
            if (!nav) return;
            window.addEventListener('scroll', function () {
                if (window.scrollY > 40) {
                    nav.classList.add('navbar-scrolled');
                } else {
                    nav.classList.remove('navbar-scrolled');
                }
            });
        }

        document.addEventListener('DOMContentLoaded', function () {
            init3DTilt();
            initNavbarScroll();
        });
        window.addEventListener('load', init3DTilt);
        setInterval(init3DTilt, 1500);
    })();
    </script>


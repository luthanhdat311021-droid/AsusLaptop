                <a asp-controller="ImageSearch" asp-action="Index" class="nav-btn icon-only" title="Tìm kiếm bằng ảnh" style="flex-shrink: 0 !important;">
                    <i class="fa fa-camera"></i>
                </a>
                <a href="/Wishlist/Index" class="nav-btn icon-only" title="Sản phẩm yêu thích" style="flex-shrink: 0 !important;">
                    <i class="fa fa-heart"></i>
                </a>
                <a href="/Compare/Index" class="nav-btn icon-only" title="So sánh cấu hình" style="flex-shrink: 0 !important;">
                    <i class="fa fa-balance-scale"></i>
                </a>

                @if (User.Identity?.IsAuthenticated == true)
                {
                    <div class="nav-notif-dropdown" id="notifDropdown" style="flex-shrink: 0 !important;">
                        <button class="nav-btn icon-only" id="notifBellBtn" title="Thông báo VIP">
                            <i class="fa fa-bell"></i>
                            <span class="cart-badge notif-badge" id="notifBadge" style="display:none;">0</span>
                        </button>
                        <div class="dropdown-menu notif-dropdown-menu luxury-dropdown" id="notifPanel">
                            <div class="notif-panel-header">
                                <span><i class="fa fa-bell gold-icon"></i> Thông báo hệ thống</span>
                                <button type="button" id="notifMarkAllBtn">Đã đọc tất cả</button>
                            </div>
                            <div class="notif-panel-list" id="notifList">
                                <div class="notif-empty">Đang tải...</div>
                            </div>
                        </div>
                    </div>
                }

                <a href="/Cart" class="nav-cart-btn luxury-cart-btn" title="Giỏ hàng của bạn" style="flex-shrink: 0 !important;">
                    <i class="fa fa-shopping-bag"></i>
                    <span class="cart-badge" id="cartBadge">@(ViewBag.CartCount ?? 0)</span>
                </a>

                <!-- LANGUAGE TOGGLE -->
                <div class="lang-toggle luxury-lang-btn" id="langToggle" title="Chuyển ngôn ngữ / Switch language" style="flex-shrink: 0 !important;">
                    <span class="lang-flag" id="langFlag">🇻🇳</span>
                    <span class="lang-label" id="langLabel">VI</span>
                </div>
            </div>

            <button class="nav-toggle" id="navToggle"><i class="fa fa-bars"></i></button>
        </div>

        <!-- Series nav -->
        <div class="series-nav" id="seriesNav">
            <div class="series-nav-inner">
                <a href="/Home/Story" class="series-link story-link"><i class="fa-solid fa-wand-magic-sparkles"></i> <span class="link-text">HÀNH TRÌNH STORY</span> <span style="background: #00f3ff; color: #050b14; font-size: 0.65rem; padding: 2px 6px; border-radius: 10px; font-weight: 900; margin-left: 4px;">NEON</span></a>
                <a href="/?series=ROG+Strix" class="series-link rog"><i class="fa fa-gamepad"></i> <span class="link-text">ROG Strix</span></a>
                <a href="/?series=ROG+Zephyrus" class="series-link rog"><i class="fa fa-bolt"></i> <span class="link-text">ROG Zephyrus</span></a>
                <a href="/?series=ROG+Flow" class="series-link rog"><i class="fa fa-sync"></i> <span class="link-text">ROG Flow</span></a>
                <a href="/?series=TUF+Gaming" class="series-link tuf"><i class="fa fa-shield-alt"></i> <span class="link-text">TUF Gaming</span></a>
                <a href="/?series=ZenBook" class="series-link zen"><i class="fa fa-feather"></i> <span class="link-text">ZenBook</span></a>
                <a href="/?series=VivoBook" class="series-link vivo"><i class="fa fa-laptop"></i> <span class="link-text">VivoBook</span></a>
                <a href="/?series=ProArt" class="series-link proart"><i class="fa fa-palette"></i> <span class="link-text">ProArt Studio</span></a>
                <a href="/?series=ExpertBook" class="series-link expert"><i class="fa fa-briefcase"></i> <span class="link-text">ExpertBook</span></a>
            </div>
        </div>
    </nav>

    <!-- TOAST NOTIFICATION -->
    @if (TempData["SuccessMessage"] != null)
    {
        <div class="toast toast-success" id="toastMsg">
            <i class="fa fa-check-circle"></i> @TempData["SuccessMessage"]
        </div>
    }
    @if (TempData["ErrorMessage"] != null)
    {
        <div class="toast toast-error" id="toastMsg">
            <i class="fa fa-exclamation-circle"></i> @TempData["ErrorMessage"]
        </div>
    }

    <!-- MAIN CONTENT -->
    <main class="luxury-main">
        @RenderBody()
    </main>

    <!-- FOOTER LUXURY -->

                <div class="contact-item"><i class="fa fa-envelope gold-icon"></i> <div><strong>Email Concierge:</strong> <span>vip@@asuslaptop.vn</span></div></div>
                <div class="contact-item"><i class="fa fa-map-marker-alt gold-icon"></i> <div><strong>Showroom Flagship:</strong> <span>123 Nguyễn Huệ, Q.1, TP.HCM</span></div></div>

    <!-- ===== VOICE SEARCH / VOICE COMMAND ===== -->
    <script>
    (function () {
        var micBtn   = document.getElementById('voiceSearchBtn');
        var input    = document.getElementById('navSearchInput');
        var form     = document.getElementById('navSearchForm');
        var statusEl = document.getElementById('voiceStatus');
        if (!micBtn || !input || !form) return;

        var SpeechRecognitionCtor = window.SpeechRecognition || window.webkitSpeechRecognition;
        if (!SpeechRecognitionCtor) {
            micBtn.classList.add('unsupported');
            return;
        }

        // Lệnh điều hướng bằng giọng nói: từ khóa -> URL
        var commands = [
            { keys: ['trang chủ', 'về trang chủ'], url: '/' },
            { keys: ['giỏ hàng', 'xem giỏ hàng'], url: '/Cart' },
            { keys: ['thanh toán'], url: '/Cart' },
            { keys: ['yêu thích', 'sản phẩm yêu thích'], url: '/Wishlist/Index' },
            { keys: ['đơn hàng của tôi', 'đơn hàng'], url: '/Account/MyOrders' },
            { keys: ['tài khoản', 'hồ sơ của tôi'], url: '/Account/Profile' },
            { keys: ['đăng nhập'], url: '/Account/Login' },
            { keys: ['đăng ký', 'tạo tài khoản'], url: '/Account/Register' },
            { keys: ['đăng xuất'], url: '/Account/Logout' },
            { keys: ['so sánh sản phẩm', 'so sánh'], url: '/Compare/Index' },
            { keys: ['tìm bằng ảnh', 'tìm kiếm bằng ảnh'], url: '/ImageSearch/Index' }
        ];

        var recognition = new SpeechRecognitionCtor();
        recognition.lang = 'vi-VN';
        recognition.continuous = false;
        recognition.interimResults = true;
        recognition.maxAlternatives = 1;

        var listening = false;
        var finalTranscript = '';

        function showStatus(text, opts) {
            opts = opts || {};
            statusEl.innerHTML = opts.dot === false ? text : '<span class="voice-dot"></span>' + text;
            statusEl.classList.toggle('error', !!opts.error);
            statusEl.classList.add('show');
        }
        function hideStatus(delay) {
            setTimeout(function () { statusEl.classList.remove('show'); }, delay || 0);
        }

        function normalize(s) {
            return (s || '').toLowerCase().trim().replace(/[.?!,]+$/g, '');
        }

        function matchCommand(text) {
            var t = normalize(text);
            for (var i = 0; i < commands.length; i++) {
                for (var k = 0; k < commands[i].keys.length; k++) {
                    if (t.indexOf(commands[i].keys[k]) !== -1) return commands[i];
                }
            }
            return null;
        }

        function startListening() {
            if (listening) { recognition.stop(); return; }
            finalTranscript = '';
            try { recognition.start(); }
            catch (e) { /* already started */ }
        }

        recognition.addEventListener('start', function () {
            listening = true;
            micBtn.classList.add('listening');
            micBtn.querySelector('i').className = 'fa fa-microphone';
            showStatus('Đang nghe… hãy nói tên sản phẩm hoặc lệnh');
        });

        recognition.addEventListener('result', function (e) {
            var interim = '';
            for (var i = e.resultIndex; i < e.results.length; i++) {
                if (e.results[i].isFinal) finalTranscript += e.results[i][0].transcript;
                else interim += e.results[i][0].transcript;
            }
            var preview = (finalTranscript + interim).trim();
            if (preview) {
                input.value = preview;
                showStatus('"' + preview + '"');
            }
        });

        recognition.addEventListener('error', function (e) {
            var msg = 'Có lỗi xảy ra, thử lại nhé';
            if (e.error === 'not-allowed' || e.error === 'service-not-allowed') {
                msg = 'Vui lòng cho phép truy cập micro để dùng tìm kiếm bằng giọng nói';
            } else if (e.error === 'no-speech') {
                msg = 'Không nghe thấy gì, thử lại nhé';
            } else if (e.error === 'network') {
                msg = 'Lỗi kết nối mạng, thử lại nhé';
            }
            showStatus(msg, { error: true, dot: false });
            hideStatus(2500);
        });

        recognition.addEventListener('end', function () {
            listening = false;
            micBtn.classList.remove('listening');

            var text = finalTranscript.trim() || input.value.trim();
            if (!text) { hideStatus(300); return; }

            var cmd = matchCommand(text);
            if (cmd) {
                showStatus('Đang chuyển đến trang tương ứng…', { dot: false });
                setTimeout(function () { window.location.href = cmd.url; }, 500);
            } else {
                input.value = text;
                showStatus('Đang tìm kiếm "' + text + '"…', { dot: false });
                setTimeout(function () { form.submit(); }, 400);
            }
        });

        micBtn.addEventListener('click', startListening);
    })();
    </script>

    <!-- SOMEE FREE HOSTING AD & GOOGLE TRANSLATE BANNER KILLER (FLUSH TOP EDGE) -->
    <script>
    (function () {
        function killTopAdsAndFlushTop() {
            document.documentElement.style.setProperty('top', '0px', 'important');
            document.documentElement.style.setProperty('margin-top', '0px', 'important');
            document.documentElement.style.setProperty('padding-top', '0px', 'important');
            document.body.style.setProperty('top', '0px', 'important');
            document.body.style.setProperty('margin-top', '0px', 'important');
            document.body.style.setProperty('padding-top', '0px', 'important');

            // Xóa triệt để mọi phần tử quảng cáo / iframe đứng trước .topbar hoặc .navbar
            if (document.body) {
                var topbar = document.body.querySelector('.topbar') || document.body.querySelector('.navbar');
                if (topbar) {
                    var prev = topbar.previousElementSibling;
                    while (prev) {
                        var toDelete = prev;
                        prev = prev.previousElementSibling;
                        toDelete.remove();
                    }
                }
            }

            // Xóa mọi iframe banner / skiptranslate / center tự động sinh ra ngoài trang chủ
            var elements = document.querySelectorAll('iframe.goog-te-banner-frame, .goog-te-banner-frame, .VIpgJd-Z44Wfd-a91vB-sn5lh, body > .skiptranslate, body > center');
            elements.forEach(function (el) {
                if (el && !el.closest('.topbar') && !el.closest('.navbar')) {
                    el.remove();
                }
            });
        }

        killTopAdsAndFlushTop();
        document.addEventListener('DOMContentLoaded', killTopAdsAndFlushTop);
        window.addEventListener('load', killTopAdsAndFlushTop);
        setInterval(killTopAdsAndFlushTop, 50);
    })();
    </script>

    <!-- ===== AI SMART MATCHMAKER JAYS SCRIPT ===== -->
    <script>
    var aiSelection = { usage: '', budget: '', feature: '' };

    function openAiWizard() {
        var overlay = document.getElementById('aiModalOverlay');
        if (overlay) overlay.classList.add('show');
        resetAiWizard();
    }

    function closeAiWizard() {
        var overlay = document.getElementById('aiModalOverlay');
        if (overlay) overlay.classList.remove('show');
    }

    function selectAiOpt(stepKey, val, btn) {
        aiSelection[stepKey] = val;

        if (stepKey === 'usage') {
            document.getElementById('aiStep1').classList.remove('active');
            document.getElementById('aiStep2').classList.add('active');
        } else if (stepKey === 'budget') {
            document.getElementById('aiStep2').classList.remove('active');
            document.getElementById('aiStep3').classList.add('active');
        } else if (stepKey === 'feature') {
            document.getElementById('aiStep3').classList.remove('active');
            document.getElementById('aiLoading').style.display = 'block';

            fetch('/Home/GetAiRecommendations', {
                method: 'POST',
                headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
                body: 'usage=' + encodeURIComponent(aiSelection.usage) +
                      '&budget=' + encodeURIComponent(aiSelection.budget) +
                      '&feature=' + encodeURIComponent(aiSelection.feature)
            })
            .then(function(r) { return r.json(); })
            .then(function(data) {
                document.getElementById('aiLoading').style.display = 'none';
                if (data.success && data.items && data.items.length > 0) {
                    renderAiResults(data.items);
                    document.getElementById('aiResults').classList.add('active');
                } else {
                    document.getElementById('aiResultsList').innerHTML = '<div style="text-align:center;padding:20px">Không tìm thấy sản phẩm phù hợp.</div>';
                    document.getElementById('aiResults').classList.add('active');
                }
            })
            .catch(function() {
                document.getElementById('aiLoading').style.display = 'none';
                document.getElementById('aiResultsList').innerHTML = '<div style="text-align:center;padding:20px">Lỗi kết nối máy chủ. Vui lòng thử lại.</div>';
                document.getElementById('aiResults').classList.add('active');
            });
        }
    }

    function renderAiResults(items) {
        var list = document.getElementById('aiResultsList');
        if (!list) return;

        list.innerHTML = items.map(function(item) {
            var origPriceHtml = item.originalPrice ? '<span style="text-decoration:line-through;opacity:0.6;font-size:11px;margin-right:6px;color:#fff">' + item.originalPrice + '</span>' : '';
            return '<div class="ai-item-card">' +

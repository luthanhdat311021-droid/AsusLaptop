    <!-- ===== GOOGLE TRANSLATE LANGUAGE TOGGLE ===== -->
    <div id="google_translate_element" style="display:none"></div>
    <script type="text/javascript">
        function googleTranslateElementInit() {
            new google.translate.TranslateElement({
                pageLanguage: 'vi',
                includedLanguages: 'vi,en',
                autoDisplay: false
            }, 'google_translate_element');
        }
    </script>
    <script src="//translate.google.com/translate_a/element.js?cb=googleTranslateElementInit"></script>
    <script>
        (function () {
            // Đọc cookie googtrans để biết ngôn ngữ hiện tại
            function getCookie(name) {
                var m = document.cookie.match('(^|;)\\s*' + name + '\\s*=\\s*([^;]+)');
                return m ? m.pop() : '';
            }

            var gtCookie = getCookie('googtrans'); // vd: /vi/en hoặc rỗng
            var isEN = gtCookie && gtCookie.indexOf('/en') !== -1;

            var toggleBtn = document.getElementById('langToggle');
            var flagEl    = document.getElementById('langFlag');
            var labelEl   = document.getElementById('langLabel');

            function updateUI(en) {
                if (en) {
                    flagEl.textContent  = '🇺🇸';
                    labelEl.textContent = 'EN';
                } else {
                    flagEl.textContent  = '🇻🇳';
                    labelEl.textContent = 'VI';
                }
            }
            updateUI(isEN);

            function setCookie(name, value) {
                var host = location.hostname;
                document.cookie = name + '=' + value + ';path=/';
                document.cookie = name + '=' + value + ';path=/;domain=' + host;
                document.cookie = name + '=' + value + ';path=/;domain=.' + host;
            }

            function deleteCookie(name) {
                var expired = name + '=;expires=Thu, 01 Jan 1970 00:00:00 GMT;';
                var host = location.hostname;
                // Xóa mọi biến thể path/domain có thể có, vì Google Translate
                // tự set cookie với domain=".hostname" (có dấu chấm ở đầu)
                // để dùng chung cho các subdomain.
                document.cookie = expired + 'path=/';
                document.cookie = expired + 'path=/;domain=' + host;
                document.cookie = expired + 'path=/;domain=.' + host;
                document.cookie = expired + 'path=/;domain=www.' + host;
            }

            // Cách đáng tin cậy nhất: điều khiển trực tiếp <select class="goog-te-combo">
            // mà chính widget Google Translate sinh ra, thay vì chỉ set/xóa cookie rồi
            // reload. Lý do là bản thân widget mới là bên quản lý trạng thái dịch thật
            // sự - nếu chỉ xóa cookie, có lúc widget vẫn tự ghi lại cookie /vi/en sau khi
            // trang load lại khiến trang không quay về tiếng Việt được (đây là nguyên
            // nhân của lỗi "chuyển EN -> VI không ăn").
            function switchViaWidget(targetLang) {
                var select = document.querySelector('select.goog-te-combo');
                if (!select) return false;

                select.value = targetLang;

                // Một số trình duyệt cần dispatch theo cả 2 kiểu event mới nhận diện được
                if (typeof Event === 'function') {
                    select.dispatchEvent(new Event('change'));
                } else {
                    var evt = document.createEvent('HTMLEvents');
                    evt.initEvent('change', true, true);
                    select.dispatchEvent(evt);
                }
                return true;
            }

            function switchLanguage() {
                var goingToEN = !isEN;
                var targetLang = goingToEN ? 'en' : 'vi';

                // Luôn đồng bộ cookie trước (để lần load trang sau đúng ngôn ngữ
                // ngay từ đầu, không phải chờ JS chạy xong mới đổi).
                if (goingToEN) {
                    setCookie('googtrans', '/vi/en');
                } else {
                    deleteCookie('googtrans');
                }

                // Nếu widget đã sẵn sàng thì đổi ngay tại chỗ, không cần reload
                // (đáng tin cậy hơn nhiều so với chỉ đổi cookie rồi reload).
                var switched = switchViaWidget(targetLang);

                if (switched) {
                    isEN = goingToEN;
                    updateUI(isEN);
                    // Vẫn reload để đồng bộ toàn bộ trạng thái trang (ví dụ các phần
                    // render lại theo cookie ở server, nếu có).
                    setTimeout(function () { location.reload(); }, 300);
                } else {
                    // Widget chưa kịp load (VD người dùng bấm quá nhanh) -> dùng
                    // phương án cũ: dựa vào cookie rồi reload.
                    location.reload();
                }
            }

            if (toggleBtn) {
                toggleBtn.addEventListener('click', switchLanguage);
            }
        })();
    </script>


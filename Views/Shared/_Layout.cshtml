<!DOCTYPE html>
<html lang="vi" class="notranslate" translate="no">
<head>
    <meta charset="utf-8" />
    <meta name="google" content="notranslate" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@(ViewData["Title"] != null ? ViewData["Title"] + " — " : "")ASUS Laptop Store — Flagship Store</title>
    <meta name="description" content="@(ViewData["MetaDescription"] as string ?? "Đại lý ủy quyền chính hãng ASUS tại Việt Nam. Laptop ROG, ZenBook, VivoBook, TUF Gaming... 100% chính hãng, bảo hành toàn quốc.")" />

    <!-- Open Graph / Facebook -->
    <meta property="og:type" content="@(ViewData["OgType"] as string ?? "website")" />
    <meta property="og:site_name" content="ASUS Laptop Store Flagship" />
    <meta property="og:title" content="@(ViewData["OgTitle"] as string ?? (ViewData["Title"] as string ?? "ASUS Laptop Store"))" />
    <meta property="og:description" content="@(ViewData["OgDescription"] as string ?? ViewData["MetaDescription"] as string ?? "Đại lý ủy quyền chính hãng ASUS tại Việt Nam. 100% chính hãng, bảo hành toàn quốc.")" />
    <meta property="og:image" content="@(ViewData["OgImage"] as string ?? $"{Context.Request.Scheme}://{Context.Request.Host}/image/product/tk.png")" />
    <meta property="og:url" content="@($"{Context.Request.Scheme}://{Context.Request.Host}{Context.Request.Path}{Context.Request.QueryString}")" />

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content="@(ViewData["OgTitle"] as string ?? (ViewData["Title"] as string ?? "ASUS Laptop Store"))" />
    <meta name="twitter:description" content="@(ViewData["OgDescription"] as string ?? ViewData["MetaDescription"] as string ?? "Đại lý ủy quyền chính hãng ASUS tại Việt Nam.")" />
    <meta name="twitter:image" content="@(ViewData["OgImage"] as string ?? $"{Context.Request.Scheme}://{Context.Request.Host}/image/product/tk.png")" />

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Outfit:wght@300;400;500;600;700;800;900&family=Plus+Jakarta+Sans:wght@300;400;500;600;700;800&family=Barlow:wght@300;400;500;600;700;800&family=Barlow+Condensed:wght@600;700;800&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css" />
    <link rel="stylesheet" href="~/css/site.css" />
    <link rel="stylesheet" href="~/css/asus-futuristic-3d.css" />
    <!-- Three.js CDN & Chart.js -->
    <script src="https://cdnjs.cloudflare.com/ajax/libs/three.js/r128/three.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    @await RenderSectionAsync("Styles", required: false)
    <!-- FORCE FLUSH TOP EDGE (HIDE SOMEE FREE HOSTING BANNER & GOOGLE TRANSLATE) -->
    <style>
        html, body {
            top: 0 !important;
            margin-top: 0 !important;
            padding-top: 0 !important;
            position: static !important;
        }

        /* Ẩn banner quảng cáo Somee free hosting & Google Translate top bar */
        body > center:first-child,
        body > div[style*="somee.com"],
        a[href*="somee.com"],
        iframe[src*="somee"],
        .goog-te-banner-frame,
        .goog-te-balloon-frame,
        #goog-gt-tt,
        .goog-te-gadget,
        body > .skiptranslate {
            display: none !important;
            visibility: hidden !important;
            height: 0 !important;
            width: 0 !important;
            opacity: 0 !important;
            pointer-events: none !important;
            position: absolute !important;
            top: -9999px !important;
            left: -9999px !important;
        }

        #google_translate_element {
            display: none !important;
        }
    </style>
    <style>
        /* Global reveal animation */
        .reveal { opacity: 0; transform: translateY(32px); transition: opacity .6s ease, transform .6s ease; }
        .reveal.visible { opacity: 1; transform: translateY(0); }
        .reveal:nth-child(2) { transition-delay: .08s; }
        .reveal:nth-child(3) { transition-delay: .16s; }
        .reveal:nth-child(4) { transition-delay: .24s; }
        .reveal:nth-child(5) { transition-delay: .32s; }
        .tilt-3d { will-change: transform; }
        [data-parallax] { will-change: transform; }
    </style>
</head>
<body>
    <!-- CYBERSCAN BACKGROUND OVERLAYS -->
    <div class="cyber-bg-overlay"></div>

    <!-- TOP BAR LUXURY -->
    <div class="topbar luxury-topbar">
        <div class="topbar-inner">
            <div class="topbar-item topbar-status">
                <span class="live-pulse"></span>
                <span class="topbar-text">ASUS GLOBAL FLAGSHIP STORE</span>
            </div>
            <div class="topbar-item topbar-ticker">
                <i class="fa-solid fa-crown gold-icon"></i>
                <span>Đặc quyền VIP Concierge — Hỗ trợ kỹ thuật 24/7 — Bảo hành chính hãng 2 năm tận nơi</span>
            </div>
            <div class="topbar-item topbar-info">
                <span><i class="fa fa-phone"></i> Hotline VIP: 1800 1234</span>
                <span class="dot-sep">•</span>
                <span><i class="fa-solid fa-truck-fast"></i> Giao siêu tốc 2H VIP</span>
            </div>
        </div>
    </div>

    <!-- NAVBAR LUXURY -->
    <nav class="navbar luxury-navbar">
        <div class="nav-inner" style="max-width: 1440px !important; margin: 0 auto !important; padding: 0 16px !important; height: 74px !important; display: flex !important; align-items: center !important; gap: 12px !important; flex-wrap: nowrap !important; overflow: visible !important;">
            <!-- Logo -->
            <a href="/" class="nav-logo luxury-logo" title="ASUS Laptop Store — Flagship" style="display: flex !important; flex-direction: row !important; align-items: center !important; gap: 10px !important; text-decoration: none !important; flex-shrink: 0 !important; height: auto !important;">
                <div class="logo-badge" style="width: 38px !important; height: 38px !important; border-radius: 10px !important; background: linear-gradient(135deg, #ff4d00, #d4af37) !important; display: flex !important; align-items: center !important; justify-content: center !important; color: #ffffff !important; font-size: 16px !important; flex-shrink: 0 !important;"><i class="fa-solid fa-gem"></i></div>
                <div class="logo-text-wrap" style="display: flex !important; flex-direction: column !important; justify-content: center !important; line-height: 1.15 !important; flex-shrink: 0 !important; overflow: visible !important;">
                    <span class="logo-asus" style="font-family: 'Barlow Condensed', 'Outfit', sans-serif !important; font-size: 24px !important; font-weight: 900 !important; color: #ffffff !important; letter-spacing: 2px !important; line-height: 1 !important; margin: 0 !important; padding: 0 !important; -webkit-text-fill-color: initial !important; background: none !important;">ASUS</span>
                    <span class="logo-sub" style="font-size: 9.5px !important; font-weight: 800 !important; letter-spacing: 2.5px !important; color: #ff4d00 !important; text-transform: uppercase !important; margin-top: 1px !important; padding: 0 !important; white-space: nowrap !important; display: block !important;">LAPTOP STORE</span>
                </div>
            </a>

            <!-- Search -->
            <form asp-controller="Home" asp-action="Index" method="get" class="nav-search luxury-search" id="navSearchForm" style="flex: 1 !important; max-width: 380px !important; min-width: 160px !important;">
                <div class="search-box-inner" style="position: relative;">
                    <i class="fa fa-search search-icon"></i>
                    <input type="text" name="search" id="navSearchInput" placeholder="Tìm ROG Strix, ZenBook OLED, ProArt..." value="@ViewData["SearchQuery"]" autocomplete="off" />
                    <span class="cmd-kbd-trigger" id="cmdKbdTrigger" title="Mở Smart Command Palette (Ctrl + K)">Ctrl K</span>
                    <button type="button" class="voice-search-btn" id="voiceSearchBtn" title="Tìm bằng giọng nói / Voice Search">
                        <i class="fa fa-microphone"></i>
                    </button>
                </div>
                <button type="submit" class="search-submit-btn" title="Tìm kiếm"><i class="fa fa-arrow-right"></i></button>
            </form>


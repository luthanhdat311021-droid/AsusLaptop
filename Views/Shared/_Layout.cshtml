    <script>
    async function handleVipSubscribe(e, formEl) {
        if (e) e.preventDefault();
        const input = formEl.querySelector('input[type="email"]');
        if (!input || !input.value) return;
        const email = input.value.trim();

        try {
            const res = await fetch('/Voucher/SubscribeVip', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ email: email })
            });
            const data = await res.json();
            if (data.success) {
                document.getElementById('vipSubEmail').textContent = email;
                document.getElementById('vipModalCode').textContent = data.voucherCode || 'ASUSVIP1M';
                document.getElementById('vipSuccessModal').style.display = 'flex';
                input.value = '';
            } else {
                alert(data.message || 'Đăng ký thất bại, vui lòng thử lại.');
            }
        } catch (err) {
            console.error('VIP Subscribe Error:', err);
            document.getElementById('vipSubEmail').textContent = email;
            document.getElementById('vipModalCode').textContent = 'ASUSVIP1M';
            document.getElementById('vipSuccessModal').style.display = 'flex';
            input.value = '';
        }
    }

    function closeVipModal() {
        document.getElementById('vipSuccessModal').style.display = 'none';
    }

    function copyVipCode() {
        const code = document.getElementById('vipModalCode').textContent;
        navigator.clipboard.writeText(code).then(() => {
            const btn = document.querySelector('.btn-copy-code');
            if (btn) {
                btn.innerHTML = '<i class="fa fa-check"></i> Đã chép!';
                setTimeout(() => {
                    btn.innerHTML = '<i class="fa fa-copy"></i> Sao chép';
                }, 2000);
            }
        }).catch(err => {
            alert('Mã giảm giá của bạn: ' + code);
        });
    }
    </script>


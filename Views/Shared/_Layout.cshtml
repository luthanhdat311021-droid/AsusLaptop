        .cmd-item-icon.radar { background: linear-gradient(135deg, #10b981, #059669); }
        .cmd-item-icon.cart { background: linear-gradient(135deg, #f59e0b, #d97706); }
        .cmd-item-thumb {
            width: 44px;
            height: 34px;
            object-fit: contain;
            border-radius: 6px;
            background: rgba(255, 255, 255, 0.05);
            padding: 2px;
        }

        .cmd-item-info {
            flex: 1;
            display: flex;
            flex-direction: column;
            line-height: 1.3;
        }
        .cmd-item-info strong {
            font-size: 14px;
            font-weight: 600;
        }
        .cmd-item-info span {
            font-size: 12px;
            color: #94a3b8;
        }

        .cmd-fps-badge {
            background: rgba(16, 185, 129, 0.15);
            border: 1px solid rgba(16, 185, 129, 0.4);
            color: #34d399;
            font-size: 11px;
            font-weight: 700;
            padding: 3px 8px;
            border-radius: 6px;
            display: flex;
            align-items: center;
            gap: 4px;
            white-space: nowrap;
        }

        .cmd-item-price {
            font-size: 14px;
            font-weight: 800;
            color: #ff4d00;
            margin-left: auto;
        }

        .cmd-key {
            font-size: 11px;
            color: #64748b;
            background: rgba(255, 255, 255, 0.06);
            padding: 2px 6px;
            border-radius: 4px;
        }

        .cmd-palette-footer {
            display: flex;
            align-items: center;
            justify-content: space-between;
            padding: 12px 20px;
            background: rgba(10, 15, 30, 0.6);
            border-top: 1px solid rgba(255, 255, 255, 0.08);
            font-size: 12px;
            color: #64748b;
        }
        .cmd-hints {
            display: flex;
            gap: 14px;
        }
        .cmd-hints kbd {
            background: rgba(255, 255, 255, 0.1);
            color: #cbd5e1;
            padding: 1px 5px;
            border-radius: 4px;
            font-size: 10px;
            font-weight: 700;
        }
    </style>

    <script>
        (function () {
            const overlay = document.getElementById('cmdPaletteOverlay');
            const input = document.getElementById('cmdInput');
            const defaultActions = document.getElementById('cmdDefaultActions');
            const searchResults = document.getElementById('cmdSearchResults');
            const resultsList = document.getElementById('cmdResultsList');
            const kbdTrigger = document.getElementById('cmdKbdTrigger');

            function openPalette() {
                overlay.classList.add('open');
                input.value = '';
                searchResults.style.display = 'none';
                defaultActions.style.display = 'block';
                setTimeout(() => input.focus(), 50);
            }

            function closePalette() {
                overlay.classList.remove('open');
            }

            // Keyboard shortcut triggers: Ctrl + K, Cmd + K
            document.addEventListener('keydown', function (e) {
                if ((e.ctrlKey || e.metaKey) && e.key.toLowerCase() === 'k') {
                    e.preventDefault();
                    if (overlay.classList.contains('open')) closePalette();
                    else openPalette();
                } else if (e.key === 'Escape' && overlay.classList.contains('open')) {
                    closePalette();
                }
            });

            kbdTrigger?.addEventListener('click', openPalette);
            overlay?.addEventListener('click', function (e) {
                if (e.target === overlay) closePalette();
            });

            // Live Search Engine
            let debounceTimer = null;
            input?.addEventListener('input', function () {
                const query = input.value.trim();
                clearTimeout(debounceTimer);

                if (query.length < 2) {
                    searchResults.style.display = 'none';
                    defaultActions.style.display = 'block';
                    return;
                }

                debounceTimer = setTimeout(() => {
                    fetch('/Home/QuickSearch?q=' + encodeURIComponent(query))
                        .then(r => r.json())
                        .then(data => {
                            if (data.success && data.products && data.products.length > 0) {
                                resultsList.innerHTML = data.products.map(p => `
                                    <a href="/Product/Details/${p.id}" class="cmd-item">
                                        <img src="${p.imageUrl}" alt="${p.name}" class="cmd-item-thumb" />
                                        <div class="cmd-item-info">
                                            <strong>${p.name}</strong>
                                            <span>${p.cpu} • ${p.ram} • ${p.gpu}</span>
                                        </div>
                                        <div class="cmd-fps-badge"><i class="fa-solid fa-gamepad"></i> ~${p.estimatedFps} FPS</div>
                                        <div class="cmd-item-price">${p.price}</div>
                                    </a>
                                `).join('');
                                defaultActions.style.display = 'none';
                                searchResults.style.display = 'block';
                            } else {
                                resultsList.innerHTML = '<div style="padding:16px; text-align:center; color:#64748b; font-size:13px;">Không tìm thấy laptop phù hợp từ khóa</div>';
                                defaultActions.style.display = 'none';
                                searchResults.style.display = 'block';
                            }
                        }).catch(() => {});
                }, 180);
            });
        })();
    </script>
</body>
</html>

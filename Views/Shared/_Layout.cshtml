    @if (User.Identity?.IsAuthenticated == true)
    {
        @Html.AntiForgeryToken()
        <script src="https://cdnjs.cloudflare.com/ajax/libs/microsoft-signalr/8.0.0/signalr.min.js"></script>
    }

    <script>
        // Toast auto-hide
        const toast = document.getElementById('toastMsg');
        if (toast) {
            setTimeout(() => toast.classList.add('toast-hide'), 3500);
            setTimeout(() => toast.remove(), 4000);
        }

        // User dropdown
        const userBtn = document.querySelector('.user-btn');
        const userDropdown = document.querySelector('.user-dropdown');
        if (userBtn) {
            userBtn.addEventListener('click', (e) => {
                e.stopPropagation();
                userDropdown.classList.toggle('open');
            });
            document.addEventListener('click', () => userDropdown.classList.remove('open'));
        }

        // ===== Chuông thông báo realtime =====
        (function () {
            const bellBtn = document.getElementById('notifBellBtn');
            const panel = document.getElementById('notifPanel');
            const badge = document.getElementById('notifBadge');
            const listEl = document.getElementById('notifList');
            const markAllBtn = document.getElementById('notifMarkAllBtn');
            if (!bellBtn) return;

            function timeAgo(dateStr) {
                const d = new Date(dateStr);
                const diffMin = Math.floor((Date.now() - d.getTime()) / 60000);
                if (diffMin < 1) return 'Vừa xong';
                if (diffMin < 60) return diffMin + ' phút trước';
                const diffH = Math.floor(diffMin / 60);
                if (diffH < 24) return diffH + ' giờ trước';
                return d.toLocaleDateString('vi-VN');
            }

            function iconFor(type) {
                switch (type) {
                    case 'Order': return 'fa-box';
                    case 'Promotion': return 'fa-tag';
                    case 'Review': return 'fa-star';
                    case 'Stock': return 'fa-warehouse';
                    default: return 'fa-bell';
                }
            }

            function renderList(items) {
                if (!items.length) {
                    listEl.innerHTML = '<div class="notif-empty">Không có thông báo nào</div>';
                    return;
                }
                listEl.innerHTML = items.map(function (n) {
                    return '<div class="notif-item ' + (n.isRead ? '' : 'unread') + '" data-id="' + n.id + '" data-url="' + (n.actionUrl || '') + '">' +
                        '<div class="notif-item-icon"><i class="fa ' + iconFor(n.type) + '"></i></div>' +
                        '<div class="notif-item-body">' +
                        '<div class="notif-item-title">' + n.title + '</div>' +
                        '<div class="notif-item-msg">' + n.message + '</div>' +
                        '<div class="notif-item-time">' + timeAgo(n.createdAt) + '</div>' +
                        '</div></div>';
                }).join('');

                listEl.querySelectorAll('.notif-item').forEach(function (el) {
                    el.addEventListener('click', function () {
                        const id = this.dataset.id;
                        const url = this.dataset.url;
                        fetch('/Notification/MarkAsRead', {
                            method: 'POST',
                            headers: { 'Content-Type': 'application/x-www-form-urlencoded', 'RequestVerificationToken': antiForgeryToken() },
                            body: 'id=' + id
                        }).then(function () { if (url) window.location.href = url; else loadNotifications(); });
                    });
                });
            }

            function antiForgeryToken() {
                const el = document.querySelector('input[name="__RequestVerificationToken"]');
                return el ? el.value : '';
            }

            function updateBadge(count) {
                if (count > 0) { badge.style.display = 'flex'; badge.textContent = count > 99 ? '99+' : count; }
                else badge.style.display = 'none';
            }

            function loadNotifications() {
                fetch('/Notification/List').then(function (r) { return r.json(); }).then(function (data) {
                    renderList(data.items || []);
                    updateBadge(data.unread || 0);
                }).catch(function () {});
            }

            bellBtn.addEventListener('click', function (e) {
                e.stopPropagation();
                panel.classList.toggle('open');
                if (panel.classList.contains('open')) loadNotifications();
            });
            document.addEventListener('click', function () { panel.classList.remove('open'); });

            if (markAllBtn) {
                markAllBtn.addEventListener('click', function (e) {
                    e.stopPropagation();
                    fetch('/Notification/MarkAllAsRead', {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/x-www-form-urlencoded', 'RequestVerificationToken': antiForgeryToken() }
                    }).then(loadNotifications);
                });
            }

            loadNotifications();

            // Kết nối SignalR để nhận thông báo tức thời không cần tải lại trang
            if (window.signalR) {
                const conn = new signalR.HubConnectionBuilder().withUrl('/hubs/notifications').withAutomaticReconnect().build();
                conn.on('ReceiveNotification', function () { loadNotifications(); });
                conn.start().catch(function (err) { console.error('Notification hub error:', err); });
            }
        })();

        // Mobile nav toggle
        document.getElementById('navToggle')?.addEventListener('click', () => {
            document.getElementById('seriesNav')?.classList.toggle('mobile-open');
        });

        // ===== SERIES NAV: hiệu ứng xáo chữ (text scramble) khi hover =====
        (function () {
            const SCRAMBLE_CHARS = 'ABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789';

            function scramble(span) {
                if (span._scrambling) return;
                const finalText = span.textContent;
                let frame = 0;
                const totalFrames = 10; // ~ thời lượng hiệu ứng
                span._scrambling = true;

                clearInterval(span._scrambleTimer);
                span._scrambleTimer = setInterval(() => {
                    frame++;
                    const revealCount = Math.floor((frame / totalFrames) * finalText.length);
                    span.textContent = finalText
                        .split('')
                        .map((ch, i) => {
                            if (ch === ' ') return ' ';
                            if (i < revealCount) return finalText[i];
                            return SCRAMBLE_CHARS[Math.floor(Math.random() * SCRAMBLE_CHARS.length)];
                        })
                        .join('');

                    if (frame >= totalFrames) {
                        clearInterval(span._scrambleTimer);
                        span.textContent = finalText;
                        span._scrambling = false;
                    }
                }, 35);
            }

            document.querySelectorAll('.series-link').forEach(link => {
                const span = link.querySelector('.link-text');
                if (!span) return;
                link.addEventListener('mouseenter', () => scramble(span));
            });
        })();

        // ===== SCROLL-DRIVEN ANIMATIONS (Global) =====
        (function () {
            // Navbar shrink on scroll
            const navbar = document.querySelector('.navbar');
            function updateNavbar() {
                if (window.scrollY > 60) navbar?.classList.add('scrolled');
                else navbar?.classList.remove('scrolled');
            }
            window.addEventListener('scroll', updateNavbar, { passive: true });
            updateNavbar();

            // Parallax layers (elements with data-parallax="speed" attribute)
            const parallaxEls = document.querySelectorAll('[data-parallax]');
            function updateParallax() {
                const sy = window.scrollY;
                parallaxEls.forEach(el => {
                    const speed = parseFloat(el.dataset.parallax) || 0.3;
                    el.style.transform = `translateY(${sy * speed}px)`;
                });
            }
            if (parallaxEls.length) {
                window.addEventListener('scroll', updateParallax, { passive: true });
            }

            // Smooth scroll-reveal for elements with class .reveal, .reveal-left, .reveal-right, .reveal-zoom
            const revealObserver = new IntersectionObserver((entries) => {
                entries.forEach((entry) => {
                    if (entry.isIntersecting) {
                        entry.target.classList.add('visible');
                        revealObserver.unobserve(entry.target);
                    }
                });
            }, { threshold: 0.08, rootMargin: '0px 0px -40px 0px' });
            document.querySelectorAll('.reveal, .reveal-left, .reveal-right, .reveal-zoom, .usp-card, .tech-card, .review-card, .product-card').forEach(el => {
                if (!el.classList.contains('visible')) {
                    if (!el.classList.contains('reveal') && !el.classList.contains('reveal-left') && !el.classList.contains('reveal-right') && !el.classList.contains('reveal-zoom')) {
                        el.classList.add('reveal');
                    }
                    revealObserver.observe(el);
                }
            });

            // 3D tilt on any element with class .tilt-3d
            document.querySelectorAll('.tilt-3d').forEach(el => {
                el.addEventListener('mousemove', e => {
                    const r = el.getBoundingClientRect();
                    const x = (e.clientX - r.left) / r.width - 0.5;
                    const y = (e.clientY - r.top) / r.height - 0.5;
                    el.style.transform = `perspective(800px) rotateX(${y * -14}deg) rotateY(${x * 14}deg) translateZ(10px)`;
                    el.style.transition = 'transform .05s ease';
                });
                el.addEventListener('mouseleave', () => {
                    el.style.transform = 'perspective(800px) rotateX(0) rotateY(0) translateZ(0)';
                    el.style.transition = 'transform .5s ease';
                });
            });
        })();

        // ===== CURSOR GLOW EFFECT (Antigravity-style) =====
        (function () {
            const glow = document.getElementById('cursorGlow');
            const dot = document.getElementById('cursorDot');
            if (!glow || !dot) return;
            // Skip on touch devices
            if (window.matchMedia('(hover: none)').matches) return;

            let gx = window.innerWidth / 2, gy = window.innerHeight / 2;
            let dx = gx, dy = gy;
            let tx = gx, ty = gy;

            document.addEventListener('mousemove', (e) => {
                tx = e.clientX; ty = e.clientY;
                glow.classList.add('active');
                dot.classList.add('active');
            });
            document.addEventListener('mouseleave', () => {
                glow.classList.remove('active');
                dot.classList.remove('active');
            });
            document.addEventListener('mousedown', () => dot.classList.add('dot-grow'));
            document.addEventListener('mouseup', () => dot.classList.remove('dot-grow'));

            function animate() {
                // Smooth trailing follow (lerp)
                gx += (tx - gx) * 0.12;
                gy += (ty - gy) * 0.12;
                dx += (tx - dx) * 0.35;
                dy += (ty - dy) * 0.35;
                glow.style.transform = `translate(${gx}px, ${gy}px) translate(-50%, -50%)`;
                dot.style.transform = `translate(${dx}px, ${dy}px) translate(-50%, -50%)`;
                requestAnimationFrame(animate);
            }
            animate();
        })();

        // ===== FLOATING MESSENGER-STYLE CHAT =====
        (function () {
            const fabBtn = document.getElementById('fabChatBtn');
            const fabWindow = document.getElementById('fabChatWindow');
            const fabBody = document.getElementById('fabChatBody');
            const fabInput = document.getElementById('fabChatInput');
            const fabSend = document.getElementById('fabChatSend');
            const fabCloseX = document.getElementById('fabChatCloseX');
            const fabBadge = document.getElementById('fabBadge');
            if (!fabBtn || !fabWindow) return;

            let history = [];
            let opened = false;

            function toggleChat() {
                opened = !opened;
                fabWindow.classList.toggle('open', opened);
                fabBtn.classList.toggle('open', opened);
                if (opened) {
                    fabBadge.style.display = 'none';
                    fabInput.focus();
                    fabBody.scrollTop = fabBody.scrollHeight;
                }
            }

            fabBtn.addEventListener('click', toggleChat);
            fabCloseX.addEventListener('click', toggleChat);

            function appendMsg(role, text) {
                const wrap = document.createElement('div');
                wrap.className = 'chat-msg ' + (role === 'user' ? 'user' : 'bot');
                wrap.innerHTML = `
                    <div class="chat-avatar"><i class="fa fa-${role === 'user' ? 'user' : 'headset'}"></i></div>
                    <div class="chat-bubble"></div>`;
                wrap.querySelector('.chat-bubble').textContent = text;
                fabBody.appendChild(wrap);
                fabBody.scrollTop = fabBody.scrollHeight;
                return wrap;
            }

            function appendTyping() {
                const wrap = document.createElement('div');
                wrap.className = 'chat-msg bot';
                wrap.id = 'fabTyping';
                wrap.innerHTML = `
                    <div class="chat-avatar"><i class="fa fa-headset"></i></div>
                    <div class="chat-bubble typing-dots"><span></span><span></span><span></span></div>`;
                fabBody.appendChild(wrap);
                fabBody.scrollTop = fabBody.scrollHeight;
            }

            function removeTyping() {
                document.getElementById('fabTyping')?.remove();
            }

            async function sendMessage() {
                const text = fabInput.value.trim();
                if (!text) return;
                appendMsg('user', text);
                history.push({ role: 'user', content: text });
                fabInput.value = '';
                appendTyping();

                try {
                    const res = await fetch('/api/Chat/send', {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json' },
                        body: JSON.stringify({ messages: history })
                    });
                    const data = await res.json();
                    removeTyping();
                    const reply = data.reply || 'Xin lỗi, hiện chưa thể phản hồi.';
                    appendMsg('bot', reply);
                    history.push({ role: 'assistant', content: reply });
                } catch (err) {
                    removeTyping();
                    appendMsg('bot', 'Có lỗi kết nối, vui lòng thử lại sau.');
                }
            }

            fabSend.addEventListener('click', sendMessage);
            fabInput.addEventListener('keydown', (e) => {
                if (e.key === 'Enter') {
                    e.preventDefault();
                    sendMessage();
                }
            });
        })();
    </script>

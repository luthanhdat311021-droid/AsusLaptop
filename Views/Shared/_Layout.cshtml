    <script>
            console.log('[widget] script loaded');



            /* ===== FLOATING CHAT ===== */
            (function () {
                var fabBtn = document.getElementById('fabChatBtn');
                var fabWindow = document.getElementById('fabChatWindow');
                var fabBody = document.getElementById('fabChatBody');
                var fabInput = document.getElementById('fabChatInput');
                var fabSend = document.getElementById('fabChatSend');
                var fabCloseX = document.getElementById('fabChatCloseX');
                var fabBadge = document.getElementById('fabBadge');

                console.log('[widget] fabBtn found:', !!fabBtn, 'fabWindow found:', !!fabWindow);
                if (!fabBtn || !fabWindow) return;

                var history = [];
                var opened = false;

                function toggleChat() {
                    opened = !opened;
                    console.log('[widget] toggleChat ->', opened);
                    fabWindow.classList.toggle('open', opened);
                    fabBtn.classList.toggle('open', opened);
                    if (opened) {
                        if (fabBadge) fabBadge.style.display = 'none';
                        fabInput.focus();
                        fabBody.scrollTop = fabBody.scrollHeight;
                    }
                }
                fabBtn.addEventListener('click', toggleChat);
                if (fabCloseX) fabCloseX.addEventListener('click', toggleChat);

                function appendMsg(role, text) {
                    var wrap = document.createElement('div');
                    wrap.className = 'fc-msg ' + (role === 'user' ? 'user' : 'bot');
                    wrap.innerHTML = '<div class="fc-avatar"><i class="fa fa-' + (role==='user'?'user':'headset') + '"></i></div><div class="fc-bubble"></div>';
                    wrap.querySelector('.fc-bubble').textContent = text;
                    fabBody.appendChild(wrap);
                    fabBody.scrollTop = fabBody.scrollHeight;
                }
                function appendTyping() {
                    var wrap = document.createElement('div');
                    wrap.className = 'fc-msg bot'; wrap.id = 'fabTyping';
                    wrap.innerHTML = '<div class="fc-avatar"><i class="fa fa-headset"></i></div><div class="fc-bubble">...</div>';
                    fabBody.appendChild(wrap);
                    fabBody.scrollTop = fabBody.scrollHeight;
                }
                function removeTyping() {
                    var t = document.getElementById('fabTyping');
                    if (t) t.remove();
                }

                function sendMessage() {
                    var text = fabInput.value.trim();
                    if (!text) return;
                    appendMsg('user', text);
                    history.push({ role: 'user', content: text });
                    fabInput.value = '';
                    appendTyping();

                    fetch('/api/Chat/send', {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json' },
                        body: JSON.stringify({ messages: history })
                    })
                    .then(function(res){ return res.json(); })
                    .then(function(data){
                        removeTyping();
                        var reply = data.reply || 'Xin lỗi, hiện chưa thể phản hồi.';
                        appendMsg('bot', reply);
                        history.push({ role: 'assistant', content: reply });
                    })
                    .catch(function(){
                        removeTyping();
                        appendMsg('bot', 'Có lỗi kết nối, vui lòng thử lại sau.');
                    });
                }

                fabSend.addEventListener('click', sendMessage);
                fabInput.addEventListener('keydown', function(e){
                    if (e.key === 'Enter') { e.preventDefault(); sendMessage(); }
                });
            })();
             
    </script>

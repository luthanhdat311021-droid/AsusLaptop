@model List<AsusLaptop.Models.Order>
@{
    ViewData["Title"] = "Admin Dashboard";
    Layout = "_Layout";
}

<div class="admin-wrap">
    <div class="admin-header">
        <h1 class="admin-title"><i class="fa fa-tachometer-alt"></i> <span>ADMIN</span> DASHBOARD</h1>
        @if (User.IsInRole("SubAdmin")) {
            <span style="background:rgba(255,77,0,0.10);color:var(--accent);border:1px solid rgba(255,77,0,0.35);padding:4px 14px;border-radius:99px;font-size:12px;font-weight:700;margin-top:4px;display:inline-block">
                <i class="fa fa-user-shield"></i> Bạn đang đăng nhập với quyền Phó Admin
            </span>
        }
        <div class="d-flex gap-2">
            <a href="/Admin/Automation" class="btn-add" style="background:#111"><i class="fa fa-robot"></i> Tự động hóa</a>
            <a href="/Product/Create" class="btn-add"><i class="fa fa-plus"></i> Thêm sản phẩm</a>
        </div>
    </div>

    <!-- Stats -->
    <div class="stats-grid">
        <a href="#revenueSection" class="stat-card stat-card-btn">
            <div class="stat-icon revenue"><i class="fa fa-wallet"></i></div>
            <div>
                <div class="stat-card-value" style="color:var(--success)">@((ViewBag.TotalRevenue as decimal? ?? 0).ToString("N0"))₫</div>
                <div class="stat-card-label">Doanh thu</div>
            </div>
        </a>
        <a href="#ordersSection" class="stat-card stat-card-btn">
            <div class="stat-icon orders"><i class="fa fa-shopping-bag"></i></div>
            <div>
                <div class="stat-card-value">@ViewBag.TotalOrders</div>
                <div class="stat-card-label">Tổng đơn hàng</div>
            </div>
        </a>
        <a href="/Admin/Products" class="stat-card stat-card-btn">
            <div class="stat-icon products"><i class="fa fa-laptop"></i></div>
            <div>
                <div class="stat-card-value">@ViewBag.TotalProducts</div>
                <div class="stat-card-label">Sản phẩm</div>
            </div>
        </a>
        @if (User.IsInRole("Admin"))
        {
            <a href="/Admin/Users" class="stat-card stat-card-btn">
                <div class="stat-icon users"><i class="fa fa-users"></i></div>
                <div>
                    <div class="stat-card-value">@ViewBag.TotalUsers</div>
                    <div class="stat-card-label">Người dùng</div>
                </div>
            </a>
        }
        else
        {
            <div class="stat-card">
                <div class="stat-icon users"><i class="fa fa-users"></i></div>
                <div>
                    <div class="stat-card-value">@ViewBag.TotalUsers</div>
                    <div class="stat-card-label">Người dùng</div>
                </div>
            </div>
        }
        <a href="/Admin/Products" class="stat-card stat-card-btn">
            <div class="stat-icon alert"><i class="fa fa-exclamation-triangle"></i></div>
            <div>
                <div class="stat-card-value" style="color:var(--rog-red)">@ViewBag.StockAlertCount</div>
                <div class="stat-card-label">Sắp hết hàng</div>
            </div>
        </a>
        <a href="#ordersSection" class="stat-card stat-card-btn">
            <div class="stat-icon orders"><i class="fa fa-clock"></i></div>
            <div>
                <div class="stat-card-value" style="color:var(--tuf-yellow)">@ViewBag.PendingOrders</div>
                <div class="stat-card-label">Chờ xử lý</div>
            </div>
        </a>
    </div>

    <!-- Charts row -->
    <div style="display:grid;grid-template-columns:2fr 1fr;gap:20px;margin-bottom:24px">
        <!-- Sales chart -->
        <div class="admin-card" id="revenueSection">
            <div class="admin-card-header">
                <h3><i class="fa fa-chart-line"></i> Doanh thu 7 ngày qua</h3>
            </div>
            <div style="padding:20px">
                <canvas id="salesChart" height="120"></canvas>
            </div>
        </div>
        <!-- Top products -->
        <div class="admin-card">
            <div class="admin-card-header">
                <h3><i class="fa fa-trophy"></i> Top sản phẩm bán chạy</h3>
            </div>
            <div style="padding:16px">
                @if (ViewBag.TopProducts is List<TopProductViewModel> tops && tops.Any())
                {
                    @foreach (var (tp, i) in tops.Select((t, i) => (t, i)))
                    {
                        <div style="display:flex;align-items:center;gap:10px;padding:10px 0;border-bottom:1px solid var(--border)">
                            <span style="width:24px;height:24px;background:@(i==0?"var(--tuf-yellow)":i==1?"var(--text-muted)":i==2?"var(--proart-orange)":"var(--border)");border-radius:50%;display:flex;align-items:center;justify-content:center;font-size:11px;font-weight:800;color:@(i<3?"#000":"var(--text-secondary)")">@(i+1)</span>
                            <div style="flex:1;min-width:0">
                                <div style="font-size:12px;font-weight:600;overflow:hidden;text-overflow:ellipsis;white-space:nowrap">@tp.ProductName</div>
                                <div style="font-size:11px;color:var(--text-muted)">@tp.QuantitySold chiếc</div>
                            </div>
                            <span style="font-size:12px;font-weight:700;color:var(--success);white-space:nowrap">@tp.TotalRevenue.ToString("N0")₫</span>
                        </div>
                    }
                }
                else
                {
                    <p style="font-size:13px;color:var(--text-muted);text-align:center;padding:20px">Chưa có dữ liệu</p>
                }
            </div>
        </div>
    </div>

    <!-- Orders table -->
    <div class="admin-card" id="ordersSection">
        <div class="admin-card-header">
            <h3><i class="fa fa-list"></i> Tất cả đơn hàng</h3>
            <div class="d-flex gap-2 align-center">
                <a href="/Admin/Products" class="btn-action btn-view"><i class="fa fa-laptop"></i> Quản lý SP</a>
                <a href="/Admin/InventoryLogs" class="btn-action btn-view"><i class="fa fa-warehouse"></i> Nhật ký kho</a>
                <a href="/Return/AdminIndex" class="btn-action btn-view"><i class="fa fa-undo-alt"></i> Trả hàng/Hoàn tiền</a>
                @if (User.IsInRole("Admin")) {
                <a href="/Admin/Users" class="btn-action btn-edit"><i class="fa fa-users"></i> Người dùng</a>
                }
            </div>
        </div>
        <div style="overflow-x:auto">
            <table class="admin-table">
                <thead>
                    <tr>
                        <th>#ID</th>
                        <th>Khách hàng</th>
                        <th>SĐT</th>
                        <th>Tổng tiền</th>
                        <th>Thanh toán</th>
                        <th>Ngày đặt</th>
                        <th>Trạng thái</th>
                        <th>Thao tác</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var order in Model)
                    {
                        <tr>
                            <td><strong style="color:var(--accent)">#@order.Id</strong></td>
                            <td>
                                <div style="font-weight:600">@order.CustomerName</div>
                                <div style="font-size:11px;color:var(--text-muted)">@order.Email</div>
                            </td>
                            <td style="color:var(--text-secondary)">@order.Phone</td>
                            <td><strong style="color:var(--rog-red)">@order.TotalAmount.ToString("N0")₫</strong></td>
                            <td>
                                @if (order.PaymentMethod == "BankTransfer" || order.PaymentMethod == "VNPay" || order.PaymentMethod == "Momo")
                                {
                                    <div style="display:flex;flex-direction:column;gap:4px">
                                        @{
                                            (string pmIcon2, string pmLabel2, string pmColor2) = order.PaymentMethod switch
                                            {
                                                "BankTransfer" => ("fa-qrcode", "Chuyển khoản", "var(--success)"),
                                                "VNPay"        => ("fa-credit-card", "VNPay", "#0064dc"),
                                                _              => ("fa-wallet", "Ví MoMo", "#d7196e")
                                            };
                                        }
                                        <span style="font-size:11px;font-weight:700;color:@pmColor2"><i class="fa @pmIcon2"></i> @pmLabel2</span>
                                        @{
                                            string psColor = order.PaymentStatus == "Paid" ? "var(--success)" : order.PaymentStatus == "Pending" ? "var(--tuf-yellow)" : "var(--text-muted)";
                                            string psLabel = order.PaymentStatus == "Paid" ? "Đã thanh toán" : order.PaymentStatus == "Pending" ? "Chờ TT" : "Chưa TT";
                                        }
                                        <span style="font-size:10px;color:@psColor;font-weight:600">@psLabel</span>
                                    </div>
                                }
                                else
                                {
                                    <span style="font-size:11px;color:var(--text-muted)"><i class="fa fa-money-bill-wave"></i> COD</span>
                                }
                            </td>
                            <td style="font-size:12px;color:var(--text-muted)">@order.OrderDate.ToString("dd/MM/yyyy HH:mm")</td>
                            <td>
                                @if (order.Status == "Cancelled")
                                {
                                    <select class="admin-select" disabled title="Đơn đã hủy, không thể thay đổi trạng thái">
                                        <option selected>Đã hủy</option>
                                    </select>
                                }
                                else
                                {
                                    <form asp-action="UpdateOrderStatus" method="post" style="display:flex;gap:6px;align-items:center">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="orderId" value="@order.Id" />
                                        <select name="status" class="admin-select" onchange="this.form.submit()">
                                            @foreach (var s in new[] { "Pending","Processing","Shipped","Completed","Cancelled" })
                                            {
                                                <option value="@s" selected="@(order.Status == s)">
                                                    @(s switch { "Pending"=>"Chờ xử lý","Processing"=>"Xử lý","Shipped"=>"Đang giao","Completed"=>"Hoàn thành","Cancelled"=>"Đã hủy",_=>s })
                                                </option>
                                            }
                                        </select>
                                    </form>
                                }
                            </td>
                            <td>
                                <a href="/Admin/OrderDetail/@order.Id" class="btn-action btn-view"><i class="fa fa-eye"></i></a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

@section Scripts {
<script src="https://cdnjs.cloudflare.com/ajax/libs/Chart.js/4.4.1/chart.umd.min.js"></script>
<script>
const labels = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(ViewBag.ChartLabels as List<string> ?? new List<string>()));
const data   = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(ViewBag.ChartData as List<decimal> ?? new List<decimal>()));

if (labels.length > 0) {
    new Chart(document.getElementById('salesChart'), {
        type: 'line',
        data: {
            labels,
            datasets: [{
                label: 'Doanh thu (₫)',
                data,
                borderColor: '#ff4d00',
                backgroundColor: 'rgba(255,77,0,0.08)',
                borderWidth: 2,
                fill: true,
                tension: 0.4,
                pointBackgroundColor: '#ff4d00',
                pointRadius: 4
            }]
        },
        options: {
            responsive: true,
            plugins: { legend: { display: false } },
            scales: {
                x: { grid: { color: 'rgba(0,0,0,0.06)' }, ticks: { color: '#9a9a9a' } },
                y: { grid: { color: 'rgba(0,0,0,0.06)' }, ticks: { color: '#9a9a9a', callback: v => v.toLocaleString('vi-VN') + '₫' } }
            }
        }
    });
} else {
    document.getElementById('salesChart').parentElement.innerHTML = '<p style="text-align:center;padding:40px;color:var(--text-muted)">Chưa có dữ liệu doanh thu</p>';
}
</script>
}
